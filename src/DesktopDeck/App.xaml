<Application x:Class="DesktopDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B9C0CC"/>
    <SolidColorBrush x:Key="ChromeStroke" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3AFFFFFF"/>

    <!-- Shared 20-DIP hit target / translucent round grip for Calendar and icon groups. -->
    <ControlTemplate x:Key="DesktopResizeGripTemplate" TargetType="{x:Type Thumb}">
      <Grid Background="Transparent">
        <Ellipse x:Name="GripDot" Width="10" Height="10"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#A65A6579" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="GripDot" Property="Fill" Value="#D75A6579"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Application.Resources>
</Application>

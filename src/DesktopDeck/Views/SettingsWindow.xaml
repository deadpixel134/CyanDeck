                        <CheckBox x:Name="StandaloneIconChameleonCheck" Content="단독 아이콘 카멜레온 사용 (그룹과 독립)" Margin="0,4,0,6"/>
                        <TextBlock Text="커서가 없을 때 불투명도 (15~100%)" Margin="0,5,0,3"/>
                        <DockPanel Width="380" HorizontalAlignment="Left">
                            <TextBlock x:Name="StandaloneIconIdleOpacityText" DockPanel.Dock="Right" MinWidth="50" TextAlignment="Right"/>
                            <Slider x:Name="StandaloneIconIdleOpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StandaloneIconOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Text="커서를 올렸을 때 불투명도 (15~100%)" Margin="0,8,0,3"/>
                        <DockPanel Width="380" HorizontalAlignment="Left">
                            <TextBlock x:Name="StandaloneIconHoverOpacityText" DockPanel.Dock="Right" MinWidth="50" TextAlignment="Right"/>
                            <Slider x:Name="StandaloneIconHoverOpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StandaloneIconOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="StandaloneIconIncludeRecycleCheck" Content="단독 휴지통에도 위 투명도 적용" Margin="0,10,0,3"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,20" Text="끄면 일반 단독 아이콘은 불투명하게 유지됩니다. 휴지통에 적용하지 않으면 기존 그룹 카멜레온 설정을 따릅니다. 설정을 저장하면 즉시 반영됩니다. 그룹 내 아이콘과 캘린더는 변경하지 않습니다."/>
                        <TextBlock x:Name="GroupEditorSection" Text="그룹" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="FencePicker" Width="360" HorizontalAlignment="Left" SelectionChanged="FencePicker_SelectionChanged"/>
                        <TextBlock Text="현재 그룹 프리셋" Margin="0,4,0,4"/>
                        <CheckBox x:Name="LinkedIconSpacingCheck" Content="그룹 안팎의 아이콘 간격을 동일하게 사용" Margin="0,6,0,2" Checked="LinkedIconSpacingCheck_Changed" Unchecked="LinkedIconSpacingCheck_Changed"/>
                        <TextBlock Foreground="#98A3B3" Text="켜면 그룹의 격자와 자유 배치 Pack/Snap이 그룹 밖 CyanDeck 바탕화면 아이콘과 같은 기본 간격을 사용합니다. 각 그룹에 저장된 기존 가로/세로 간격 값은 덮어쓰지 않으며, 끄면 즉시 복원됩니다." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="좁게" Margin="0,0,8,0" Click="CompactPreset_Click"/>
                            <Button Content="균형" Margin="0,0,8,0" Click="BalancedPreset_Click"/>
                            <Button Content="크게" Margin="0,0,8,0" Click="LargePreset_Click"/>
                            <Button Content="그룹 옵션 초기화" Margin="0" Click="ResetSelectedGroup_Click"/>
                        </StackPanel>

                        <Grid x:Name="GroupEditor" Width="560" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="30"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="아이콘 배치"/>
                                <ComboBox x:Name="IconLayoutCombo"/>
                                <TextBlock Text="아이콘 이름"/>
                                <ComboBox x:Name="IconLabelModeCombo"/>
                                <TextBlock Text="아이콘 이름 글자 크기" Margin="0,7,0,0"/>
                                <DockPanel><TextBlock x:Name="IconLabelFontSizeText" DockPanel.Dock="Right"/><Slider x:Name="IconLabelFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="IconLabelFontSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="아이콘 크기"/>
                                <DockPanel><TextBlock x:Name="IconSizeText" DockPanel.Dock="Right"/><Slider x:Name="IconSizeSlider" Minimum="24" Maximum="128" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="IconSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="가로 간격"/>
                                <DockPanel><TextBlock x:Name="SpacingXText" DockPanel.Dock="Right"/><Slider x:Name="SpacingXSlider" Minimum="0" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SpacingXSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="세로 간격"/>
                                <DockPanel><TextBlock x:Name="SpacingYText" DockPanel.Dock="Right"/><Slider x:Name="SpacingYSlider" Minimum="0" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SpacingYSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="배경색(HEX)" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                    <TextBox x:Name="BackgroundColorBox" Width="130" Padding="6,4" VerticalContentAlignment="Center"
                                             ToolTip="#RRGGBB 또는 #AARRGGBB · 유효한 HEX 입력은 자동 반영"
                                             LostFocus="BackgroundColorBox_LostFocus" KeyDown="BackgroundColorBox_KeyDown"/>
                                    <Button x:Name="BackgroundColorSwatch" Width="27" Height="25" MinHeight="0" Padding="0" Margin="7,0,0,0" ToolTip="현재 색상 · 클릭해 컬러피커 표시"/>
                                </StackPanel>
                                <Button Content="배경화면에서 색상 선택…" HorizontalAlignment="Left" Margin="0,0,0,8" Click="WallpaperPick_Click"/>
                                <TextBlock Text="색조"/>
                                <DockPanel><TextBlock x:Name="BackgroundHueText" DockPanel.Dock="Right"/><Slider x:Name="BackgroundHueSlider" Minimum="0" Maximum="360" TickFrequency="1" ValueChanged="BackgroundAdjustment_ValueChanged"/></DockPanel>
                                <TextBlock Text="채도"/>
                                <DockPanel><TextBlock x:Name="BackgroundSaturationText" DockPanel.Dock="Right"/><Slider x:Name="BackgroundSaturationSlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BackgroundAdjustment_ValueChanged"/></DockPanel>
                                <TextBlock Text="밝기"/>
                                <DockPanel><TextBlock x:Name="BackgroundBrightnessText" DockPanel.Dock="Right"/><Slider x:Name="BackgroundBrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BackgroundAdjustment_ValueChanged"/></DockPanel>
                                <TextBlock Text="투명도"/>
                                <DockPanel><TextBlock x:Name="BackgroundTransparencyText" DockPanel.Dock="Right"/><Slider x:Name="BackgroundTransparencySlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BackgroundAdjustment_ValueChanged"/></DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="제목 표시줄"/>
                                <ComboBox x:Name="TitlebarModeCombo"/>
                                <TextBlock Text="제목 글꼴"/>
                                <ComboBox x:Name="TitleFontCombo" IsEditable="True"/>
                                <TextBlock Text="제목 글꼴 크기"/>
                                <DockPanel><TextBlock x:Name="TitleFontSizeText" DockPanel.Dock="Right"/><Slider x:Name="TitleFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TitleFontSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="제목 색상(HEX)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBox x:Name="TitleColorBox" Width="130" Padding="6,4" VerticalContentAlignment="Center" ToolTip="#RRGGBB · 유효한 HEX 입력은 자동 반영"/>
                                    <Button x:Name="TitleColorSwatch" Width="27" Height="25" MinHeight="0" Padding="0" Margin="7,0,0,0" ToolTip="현재 색상 · 클릭해 컬러피커 표시"/>
                                </StackPanel>
                                <TextBlock Text="접힌 그룹 열기 방식"/>
                                <ComboBox x:Name="RollupModeCombo"/>
                                <TextBlock Text="마우스 오버 지연"/>
                                <DockPanel><TextBlock x:Name="HoverDelayText" DockPanel.Dock="Right"/><Slider x:Name="HoverDelaySlider" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="HoverDelaySlider_ValueChanged"/></DockPanel>
                                <CheckBox x:Name="LockedCheck" Margin="0,16,0,0" Content="그룹 위치와 크기 잠금"/>
                                <CheckBox x:Name="TitlebarBottomNearTopCheck" Content="그룹이 화면 위쪽에 가까우면 제목 표시줄을 아래로 이동"/>
                                <TextBlock Margin="0,16,0,0" Foreground="#98A3B3" TextWrapping="Wrap"
                                           Text="자유 배치는 컬렉션 탭의 아이콘 좌표를 저장합니다. 폴더 포털은 폴더 변경 시 일관성을 위해 자동 격자를 계속 사용합니다."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AboutTab" Header="정보 및 문제 해결">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="590" HorizontalAlignment="Left">
                        <TextBlock x:Name="AboutSection" Text="CyanDeck" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AboutVersionText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AboutSchemaText" Foreground="#AEB8C6" Margin="0,0,0,10"/>
                        <Border Background="#20242B" BorderBrush="#3A424E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock x:Name="AboutModeText" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="UpdatesSection" Text="업데이트" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="AutomaticUpdateCheck" Content="프로그램 실행 시 GitHub Releases 업데이트 확인" />
                        <CheckBox x:Name="InstallUpdatesAutomaticallyCheck" Content="검증된 새 버전 자동 설치 후 재시작" Margin="0,4,0,4"/>
                        <TextBlock Text="업데이트 매니페스트 URL/로컬 경로 (비우면 GitHub Releases 기본 채널)"/>
                        <TextBox x:Name="UpdateManifestSourceBox" Margin="0,4,0,6" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E"/>
                        <CheckBox x:Name="RequireSignedUpdateCheck" Content="RSA-PSS 서명 검증 필수 (보안 정책, 해제 불가)" IsEnabled="False" IsChecked="True" Margin="0,2,0,4"/>
                        <TextBlock Text="신뢰할 업데이트 공개 키 PEM 경로"/>
                        <TextBox x:Name="UpdatePublicKeyPathBox" Margin="0,4,0,6" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,8" Text="Private 저장소의 업데이트에는 각 PC의 DESKTOPDECK_GITHUB_TOKEN 환경 변수가 필요합니다. RSA 공개키 PEM도 반드시 있어야 합니다. 원격 채널은 HTTPS만 허용하고 RSA-PSS 서명과 SHA-256 검증을 반드시 통과해야 설치됩니다. 로컬에 신뢰할 RSA 공개 키를 지정해야 합니다. 키 경로를 비우면 실행 파일 옆의 DesktopDeck.update-public-key.pem을 사용합니다."/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="업데이트 확인…" Margin="0,0,8,8" Click="CheckForUpdates_Click"/>
                            <Button Content="마지막 앱 업데이트 되돌리기…" Margin="0,0,8,8" Click="RollbackUpdate_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="LastUpdateCheckText" Foreground="#AEB8C6" Margin="0,0,0,16"/>

                        <TextBlock x:Name="StartupSection" Text="시작 상태" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="CrashLoopProtectionCheck" Content="비정상 시작이 반복되면 자동으로 안전 모드 진입"/>
                        <TextBlock Text="비정상 시작 기준 횟수"/>
                        <DockPanel><TextBlock x:Name="CrashLoopThresholdText" DockPanel.Dock="Right"/><Slider x:Name="CrashLoopThresholdSlider" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CrashLoopThresholdSlider_ValueChanged"/></DockPanel>
                        <TextBlock Text="보호 판단 시간"/>
                        <DockPanel><TextBlock x:Name="CrashLoopWindowText" DockPanel.Dock="Right"/><Slider x:Name="CrashLoopWindowSlider" Minimum="2" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CrashLoopWindowSlider_ValueChanged"/></DockPanel>
                        <TextBlock x:Name="StartupHealthText" Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,-4,0,8"/>
                        <Button Content="시작 상태 기록 초기화" HorizontalAlignment="Left" Margin="0,0,0,16" Click="ResetStartupHealth_Click"/>

                        <TextBlock x:Name="PolicySection" Text="관리 정책" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#20242B" BorderBrush="#3A424E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <TextBlock x:Name="ManagedPolicyStatusText" TextWrapping="Wrap" Foreground="#D6DCE5"/>
                        </Border>
                        <Button Content="관리 정책 다시 불러오기" HorizontalAlignment="Left" Margin="0,0,0,16" Click="ReloadManagedPolicy_Click"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,-8,0,16" Text="관리 정책은 로컬 또는 UNC JSON 파일에서 읽습니다. 원본이 일시적으로 손상되거나 없어져도 현재 적용 중인 정책은 자동으로 해제되지 않습니다."/>

                        <TextBlock x:Name="TroubleshootSection" Text="문제 해결" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10" Text="안전 모드는 바탕화면 마우스 후크, Shell 부모 연결, 파일 감시, Windows 아이콘 변경 없이 CyanDeck을 실행합니다. Explorer 연동이나 손상된 설정 때문에 정상 시작이 어려울 때 사용합니다."/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="자체 테스트 실행…" Margin="0,0,8,8" Click="RunSelfTest_Click"/>
                            <Button Content="설정 검사 / 복구…" Margin="0,0,8,8" Click="AboutValidateConfiguration_Click"/>
                            <Button Content="진단 묶음 만들기…" Margin="0,0,8,8" Click="CreateDiagnosticBundle_Click"/>
                            <Button Content="진단 로그 열기" Margin="0,0,8,8" Click="OpenDiagnosticLogs_Click"/>
                            <Button Content="설정 감사 로그 열기" Margin="0,0,8,8" Click="OpenSettingsAuditLog_Click"/>
                            <Button Content="설정 폴더 열기" Margin="0,0,8,8" Click="OpenSettingsFolder_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="FactoryResetSection" Text="프로그램 초기화" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="그룹·레이아웃과 CyanDeck 설정을 초기 상태로 복원합니다. 초기화 전에 원본 설정을 별도 백업합니다. 실제 파일·폴더, 로컬 캘린더 일정, Google 로그인 토큰, 캘린더 계정 데이터는 삭제하지 않습니다. 완료 후 프로그램이 다시 시작됩니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="FactoryResetButton" Content="프로그램 초기화…" HorizontalAlignment="Left" Margin="0,0,0,18" Click="FactoryReset_Click"/>

                        <TextBlock x:Name="RestartSection" Text="다시 시작 모드" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <Button Content="안전 모드로 다시 시작" Margin="0,0,8,8" Click="RestartSafeMode_Click"/>
                            <Button x:Name="RestartNormalButton" Content="일반 모드로 다시 시작" Margin="0,0,8,8" Click="RestartNormal_Click"/>
                        </WrapPanel>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,6,0,0" Text="더 새로운 CyanDeck 스키마의 설정 파일은 자동으로 덮어쓰지 않습니다. 호환성 폴더에 보존해 새 버전에서 복구할 수 있도록 합니다."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="적용" Click="Apply_Click"/>
            <Button Content="확인" IsDefault="True" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

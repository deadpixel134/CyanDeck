<Window x:Class="DesktopDeck.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyanDeck 설정" Width="940" Height="720"
        MinWidth="875" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="#15171B" Foreground="#F2F4F8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
                <ResourceDictionary Source="../Themes/ReadableComboBoxes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Let labels inherit Window.Foreground. An implicit TextBlock foreground
                 overrides ComboBoxItem.Foreground inside the native dropdown and
                 creates light-on-light unreadable entries. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}"><Setter Property="Margin" Value="0,7"/></Style>
            <Style TargetType="Label"><Setter Property="Foreground" Value="#AEB8C6"/></Style>
            <!-- Keep the native WPF ComboBox/Popup template to preserve mouse capture.
                 Only the item containers use a deterministic accessible palette. -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource ReadableComboBoxStyle}">
                <Setter Property="Margin" Value="0,4,0,10"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource DarkSliderStyle}"><Setter Property="Margin" Value="0,3,0,12"/></Style>
            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}"><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,10"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SettingsSearchBox" Height="32" Padding="9,4" TextChanged="SettingsSearchBox_TextChanged" AutomationProperties.Name="설정 검색"/>
                <TextBlock Text="설정 검색…" Margin="10,0,0,0" Foreground="#778391" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock x:Name="SettingsSearchHint" Grid.Column="1" Margin="10,0,0,0" Foreground="#98A3B3" VerticalAlignment="Center"/>
        </Grid>
        <!-- Category navigation replaces the crowded horizontal tabs. The original
             settings editors remain intact; tree leaves scroll to named sections. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1D222B" BorderBrush="#343A44" BorderThickness="1" CornerRadius="8" Padding="6,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="설정 분류" FontSize="14" FontWeight="SemiBold"
                               Foreground="#D7E3F2" Margin="10,2,0,12"/>
                    <TreeView x:Name="SettingsNavigation" Background="Transparent" Foreground="#EAF0F8"
                              BorderThickness="0" SelectedItemChanged="SettingsNavigation_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="설정 분류 트리">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#EAF0F8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="3,5"/>
                                <Setter Property="IsExpanded" Value="False"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeViewItem x:Name="NavGeneral" Header="일반 및 바탕화면" Tag="GeneralTab|FeaturesSection" IsExpanded="True">
                            <TreeViewItem Header="기능 활성화" Tag="GeneralTab|FeaturesSection"/>
                            <TreeViewItem Header="아이콘 및 자동 분류" Tag="GeneralTab|DesktopSection"/>
                            <TreeViewItem Header="페이지·입력 제스처" Tag="GeneralTab|GesturesSection"/>
                            <TreeViewItem Header="탭과 그룹 접기" Tag="GeneralTab|TabsSection"/>
                            <TreeViewItem Header="Peek 및 빠른 숨김" Tag="GeneralTab|PeekSection"/>
                            <TreeViewItem Header="성능 및 화면 복구" Tag="GeneralTab|PerformanceSection"/>
                            <TreeViewItem Header="카멜레온" Tag="GeneralTab|ChameleonSection"/>
                            <TreeViewItem Header="레이아웃 및 스냅샷" Tag="GeneralTab|SnapshotsSection"/>
                            <TreeViewItem Header="설정 초기화" Tag="GeneralTab|ResetSection"/>
                            <TreeViewItem Header="설정 백업·복원" Tag="GeneralTab|BackupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="캘린더" Tag="CalendarTab|CalendarSection">
                            <TreeViewItem Header="표시·크기·색상" Tag="CalendarTab|CalendarSection"/>
                            <TreeViewItem Header="Google 계정 연동" Tag="CalendarTab|GoogleSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Windows 기본 아이콘" Tag="SystemIconsTab|RecycleSection">
                            <TreeViewItem Header="휴지통 표시" Tag="SystemIconsTab|RecycleSection"/>
                            <TreeViewItem Header="기본 그룹·위치" Tag="SystemIconsTab|SystemGroupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="그룹 및 아이콘" Tag="GroupsTab|StandaloneSection">
                            <TreeViewItem Header="단독 아이콘 투명도" Tag="GroupsTab|StandaloneSection"/>
                            <TreeViewItem Header="그룹 모양·아이콘 배치" Tag="GroupsTab|GroupEditorSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="정보 및 문제 해결" Tag="AboutTab|AboutSection">
                            <TreeViewItem Header="버전 정보" Tag="AboutTab|AboutSection"/>
                            <TreeViewItem Header="업데이트" Tag="AboutTab|UpdatesSection"/>
                            <TreeViewItem Header="시작 상태" Tag="AboutTab|StartupSection"/>
                            <TreeViewItem Header="관리 정책" Tag="AboutTab|PolicySection"/>
                            <TreeViewItem Header="진단·복구" Tag="AboutTab|TroubleshootSection"/>
                            <TreeViewItem Header="프로그램 초기화" Tag="AboutTab|FactoryResetSection"/>
                            <TreeViewItem Header="다시 시작" Tag="AboutTab|RestartSection"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>
            <TabControl x:Name="SettingsTabs" Grid.Column="2" Background="#1B1E24" BorderBrush="#343A44">
                <!-- Retain TabItems as edit views, but remove the competing top navigation. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

            <TabItem x:Name="GeneralTab" Header="일반 및 바탕화면">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="590" HorizontalAlignment="Left">
                        <TextBlock x:Name="FeaturesSection" Text="기능별 독립 실행" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="DeckModuleCheck" Content="CyanDeck 그룹·아이콘 관리 켜기"/>
                        <CheckBox x:Name="CalendarModuleCheck" Content="바탕화면 캘린더 켜기 (날짜 더블클릭으로 입력)"/>
                        <TextBlock Text="CyanDeck 기능 전환은 셸 훅을 안전하게 정리하기 위해 프로그램을 자동 재시작합니다. 캘린더는 바로 켜고 끌 수 있습니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="DesktopSection" Text="바탕화면 동작" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="HideNativeIconsCheck" Content="CyanDeck 실행 중 Windows 바탕화면 아이콘 숨기기"/>
                        <CheckBox x:Name="AutoImportCheck" Content="Windows 바탕화면의 항목을 자동으로 가져오기"/>
                        <TextBlock Text="새 바탕화면 항목 기본 위치" Margin="0,7,0,0"/>
                        <ComboBox x:Name="DefaultDesktopPlacementCombo" Width="360" HorizontalAlignment="Left" SelectionChanged="DefaultDesktopPlacementCombo_SelectionChanged" AutomationProperties.Name="새 바탕화면 항목 기본 위치"/>
                        <CheckBox x:Name="ActivateDefaultDestinationTabCheck" Content="새 항목이 배치되면 대상 탭 활성화"/>
                        <CheckBox x:Name="LeaveNewDesktopItemsCheck" Content="새로 생긴 바탕화면 항목은 그룹 밖 바탕화면 아이콘으로 유지" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <TextBlock Foreground="#98A3B3" Text="기본값인 자동 분류는 기존 규칙/파일 종류 분류를 유지합니다. ‘그룹 밖 바탕화면’을 선택하면 새 항목을 CyanDeck 바탕화면 아이콘으로 남기며, 특정 ‘그룹 / 탭’을 선택하면 명시적 규칙에 맞지 않는 새 항목만 그 탭으로 보냅니다. Folder Portal은 목적지로 사용할 수 없습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="ShowFilePreviewsCheck" Content="미리보기를 지원하는 파일은 연결 프로그램 아이콘 대신 썸네일 표시"/>
                        <TextBlock Foreground="#98A3B3" Text="Windows Shell에 썸네일 공급자가 있는 이미지, PDF, 문서 등의 미리보기를 사용합니다. 미리보기를 가져올 수 없으면 기존 파일 아이콘으로 표시합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="HideFileShortcutBadgesCheck" Content="파일 바로가기(.lnk)의 바로가기 화살표 숨기기"/>
                        <CheckBox x:Name="HideInternetShortcutBadgesCheck" Content="인터넷 바로가기(.url, .website)의 바로가기 화살표 숨기기"/>
                        <CheckBox x:Name="ShowShortcutBadgesInFolderPortalsCheck" Content="Folder Portal 안에서도 CyanDeck 바로가기 배지 사용"/>
                        <TextBlock Foreground="#98A3B3" Text="CyanDeck이 관리하는 아이콘에는 자체 벡터 배지를 사용합니다. Folder Portal은 기본적으로 Explorer와 같은 Shell 아이콘 표시를 유지합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="KeepRulesUpdatedCheck" Content="자동 분류 규칙을 항상 최신 상태로 유지"/>
                        <Button Content="지금 자동 분류 규칙 적용" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ApplyRulesNow_Click"/>
                        <CheckBox x:Name="TrackDesktopLocationCheck" Content="실행 중 바탕화면 폴더 위치 변경 추적"/>
                        <TextBlock Foreground="#98A3B3" Text="OneDrive, Explorer, 그룹 정책 또는 알려진 폴더 설정으로 바탕화면 위치가 바뀌면 감시 경로를 자동으로 다시 연결합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 CyanDeck 실행"/>
                        <TextBlock x:Name="GesturesSection" Text="페이지 및 입력 제스처" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                        <CheckBox x:Name="EdgeGesturesCheck" Content="바탕화면 페이지 가장자리/스와이프 제스처 사용"/>
                        <CheckBox x:Name="InteriorSeamGesturesCheck" Content="모니터 사이 경계에서도 가장자리 페이지 제스처 허용" IsEnabled="{Binding IsChecked, ElementName=EdgeGesturesCheck}"/>
                        <TextBlock Foreground="#98A3B3" Text="기본값은 모니터 사이의 연속된 경계를 차단하고 실제 바탕화면 바깥쪽 가장자리에서만 전환합니다. 세로로 어긋난 모니터는 실제로 맞닿은 구간만 내부 경계로 판단합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="TouchPageGesturesCheck" Content="두 손가락 터치 스와이프로 바탕화면 페이지 전환"/>
                        <TextBlock Foreground="#98A3B3" Text="직접 터치 페이지 전환은 빈 바탕화면 입력 표면을 사용합니다. Windows 아이콘의 터치 입력을 방해하지 않도록 Windows 바탕화면 아이콘을 숨길 때만 활성화됩니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="TouchIconFlickCheck" Content="터치로 아이콘을 그룹에 튕겨 넣기"/>
                        <TextBlock Foreground="#98A3B3" Text="터치스크린에서 그룹 밖 아이콘을 원하는 일반 그룹 방향으로 빠르게 튕기면 CyanDeck 참조를 그 그룹의 현재 탭으로 이동합니다. 느린 탭/드래그와 Folder Portal은 영향을 받지 않으며 기본값은 꺼짐입니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="PageAltWheelCheck" Content="Alt + 마우스 휠로 바탕화면 페이지 전환"/>
                        <CheckBox x:Name="PageMiddleDragCheck" Content="마우스 가운데 버튼 드래그로 바탕화면 페이지 전환"/>
                        <CheckBox x:Name="PageBothButtonsDragCheck" Content="마우스 왼쪽+오른쪽 버튼 드래그로 바탕화면 페이지 전환"/>
                        <TextBlock Foreground="#E3B86A" Text="그룹이 갑자기 사라진 것처럼 보이면 다른 바탕화면 페이지로 이동했거나 빠른 숨김이 켜졌을 수 있습니다. 트레이 메뉴의 ‘표시 상태 복구’는 빠른 숨김을 해제하고 그룹이 있는 가까운 페이지로 돌아갑니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <TextBlock Text="빈 바탕화면에서 새 그룹 만들기 버튼" Margin="0,7,0,0"/>
                        <ComboBox x:Name="CreateGroupMouseButtonCombo" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="빈 바탕화면 새 그룹 생성 마우스 버튼"/>
                        <TextBlock Foreground="#98A3B3" Text="빈 바탕화면에서 선택한 버튼으로 사각형을 그린 뒤 놓으면 새 그룹 또는 Folder Portal 생성 메뉴가 열립니다. 짧은 왼쪽 클릭과 우클릭은 기존 바탕화면 동작으로 전달되며 Alt/Ctrl/Shift/Win 조합은 생성 제스처로 사용하지 않습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="UnhideOnPageSwitchCheck" Content="바탕화면 페이지 전환 시 빠른 숨김 그룹 다시 표시"/>
                        <CheckBox x:Name="AnimatePagesCheck" Content="바탕화면 페이지 전환 애니메이션"/>
                        <CheckBox x:Name="EnhancedPageEasingCheck" Content="향상된 페이지 전환 이징 사용" IsEnabled="{Binding IsChecked, ElementName=AnimatePagesCheck}"/>
                        <TextBlock Text="페이지 전환 느낌" Margin="0,2,0,0"/>
                        <ComboBox x:Name="PageEasingProfileCombo" Width="220" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=EnhancedPageEasingCheck}"/>
                        <TextBlock Foreground="#98A3B3" Text="부드럽게는 자연스럽게 감속하고, 빠르게는 더 즉각적으로 정착하며, 완만하게는 시작과 끝을 모두 부드럽게 만듭니다. Windows에서 애니메이션을 끈 경우 이 설정보다 시스템 접근성 설정을 우선합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="BouncePagesCheck" Content="페이지 전환 후 그룹에 가벼운 바운스 효과" IsEnabled="{Binding IsChecked, ElementName=EnhancedPageEasingCheck}"/>
                        <CheckBox x:Name="SmartSnapCheck" Content="그룹 간격과 가장자리를 일정하게 맞춤"/>
                        <TextBlock Foreground="#98A3B3" Text="Deck의 제목줄뿐 아니라 탭 오른쪽 빈 공간과 항목이 없는 본문 배경을 왼쪽 버튼으로 끌어 이동할 수 있습니다. 이 옵션을 켜면 이동 중 다른 Deck의 가장자리/간격과 모니터 작업 영역 가장자리에 실시간으로 맞춰집니다. Ctrl/Shift+자유 배치 빈 공간 드래그는 다중 선택 사각형으로 유지됩니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="SnapGroupSizeCheck" Content="그룹 크기를 아이콘 셀 단위에 맞춰 조정"/>
                        <TextBlock Text="그룹 맞춤 간격"/>
                        <DockPanel><TextBlock x:Name="SnapGapText" DockPanel.Dock="Right"/><Slider x:Name="SnapGapSlider" Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SnapGapSlider_ValueChanged"/></DockPanel>

                        <TextBlock x:Name="TabsSection" Text="탭 그룹" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                        <CheckBox x:Name="EnableTabGroupsCheck" Content="그룹을 다른 그룹에 놓아 탭으로 결합 허용"/>
                        <CheckBox x:Name="ConfirmTabGroupMergeCheck" Content="그룹을 탭 그룹으로 결합하기 전에 확인"/>
                        <TextBlock Text="탭 전환 방식" Margin="0,8,0,0"/>
                        <ComboBox x:Name="TabSwitchModeCombo" Width="290" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="탭 전환 방식">
                            <ComboBoxItem Content="클릭하여 전환 (기본값)"/>
                            <ComboBoxItem Content="마우스를 올리면 자동 전환"/>
                        </ComboBox>
                        <TextBlock Foreground="#98A3B3" Text="기본값은 클릭 전환입니다. 마우스를 올리기만 해서는 탭이 바뀌지 않습니다. 자동 전환은 두 번째 옵션을 직접 선택할 때만 적용되며, 탭 드래그 중에는 작동하지 않습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>

                        <TextBlock x:Name="RollupSection" Text="그룹 접기" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                        <CheckBox x:Name="EnableRollupCheck" Content="그룹 접기 기능 사용"/>
                        <CheckBox x:Name="RollupDoubleClickCheck" Content="그룹 제목 표시줄을 두 번 클릭해 접기/펼치기"/>
                        <CheckBox x:Name="RollupEdgeDockCheck" Content="화면 위/아래 가장자리로 이동하면 자동으로 접기"/>
                        <TextBlock Foreground="#98A3B3" Text="가장자리에 고정된 그룹은 위/아래 고정 위치를 기억합니다. 마우스 오버/클릭 열기 동작은 그룹별로 설정할 수 있습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>

                        <TextBlock x:Name="PeekSection" Text="Peek 및 마우스 핫 코너" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                        <CheckBox x:Name="PeekHotCornerCheck" Content="기본 작업 표시줄의 Peek 핫 코너 사용"/>
                        <TextBlock Text="핫 코너 왼쪽 클릭"/>
                        <ComboBox x:Name="PeekHotCornerLeftCombo" Width="260" HorizontalAlignment="Left"/>
                        <TextBlock Text="핫 코너 오른쪽 클릭"/>
                        <ComboBox x:Name="PeekHotCornerRightCombo" Width="260" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="PeekTaskbarButtonCheck" Content="Peek 작업 표시줄 버튼 표시 (선택 사항)"/>
                        <TextBlock Foreground="#98A3B3" Text="Peek는 트레이 메뉴와 마우스 핫 코너를 통해 사용할 수 있습니다. 시스템 전체 키보드 입력은 감시하지 않습니다." TextWrapping="Wrap" Margin="0,-4,0,8"/>


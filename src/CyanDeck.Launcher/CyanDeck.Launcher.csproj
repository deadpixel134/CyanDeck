<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>CyanDeck</AssemblyName>
    <RootNamespace>CyanDeck.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <ApplicationIcon>../DesktopDeck/AppIcon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>CyanDeck</Product>
    <Title>CyanDeck Compatibility Launcher (Preview)</Title>
    <Version>7.49.6</Version>
  </PropertyGroup>
</Project>

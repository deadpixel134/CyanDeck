                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="CalendarAppearanceSection" Text="글자와 배경" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="날짜 · 요일 · 월 제목 글자 크기" Margin="0,0,0,3"/>
                        <DockPanel Width="280" HorizontalAlignment="Left">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=CalendarDateFontSizeSlider, StringFormat='{}{0:0} px'}"/>
                            <Slider x:Name="CalendarDateFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <TextBlock Text="일정 제목 글자 크기" Margin="0,7,0,3"/>
                        <DockPanel Width="280" HorizontalAlignment="Left">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=CalendarEventFontSizeSlider, StringFormat='{}{0:0} px'}"/>
                            <Slider x:Name="CalendarEventFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <CheckBox x:Name="CalendarChameleonCheck" Content="사용하지 않을 때 배경을 흐리게 (캘린더 카멜레온)"/>

                            </StackPanel>
                        </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="UpdatesTab" Header="업데이트·정보">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="업데이트·정보" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="새 버전 확인과 자동 업데이트를 설정하고, 현재 버전과 실행 모드를 확인합니다." Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="UpdatesSection" Text="업데이트" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="AutomaticUpdateCheck" Content="프로그램 실행 시 GitHub Releases 업데이트 확인" />
                        <CheckBox x:Name="InstallUpdatesAutomaticallyCheck" Content="검증된 새 버전 자동 설치 후 재시작" Margin="0,4,0,4"/>
                         <CheckBox x:Name="BetaUpdateChannelCheck" Content="베타 채널 업데이트 활성화 (시험판 수신)" Margin="0,5,0,4"/>
                         <TextBlock Foreground="#E6BE7A" TextWrapping="Wrap" Margin="0,0,0,8" Text="베타 채널은 공개된 정식·베타 릴리스 중 높은 버전을 받습니다. RSA-PSS 서명과 SHA-256 검증은 동일하게 적용됩니다. 선택하면 아래 사용자 지정 매니페스트 주소보다 베타 채널을 우선합니다. 베타에서 정식으로 전환해도 이전 버전으로 자동 다운그레이드하지 않습니다."/>
                         <TextBlock Foreground="#B7DCE8" FontWeight="SemiBold" Margin="0,0,0,9">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Setter Property="Text" Value="현재 선택 채널: 정식 (안정판)"/>
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsChecked, ElementName=BetaUpdateChannelCheck}" Value="True">
                                             <Setter Property="Text" Value="현재 선택 채널: 베타 (시험판 포함)"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                        <TextBlock Text="업데이트 매니페스트 URL/로컬 경로 (비우면 GitHub Releases 기본 채널)"/>
                        <TextBox x:Name="UpdateManifestSourceBox" Margin="0,4,0,6" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E"/>
                        <CheckBox x:Name="RequireSignedUpdateCheck" Content="RSA-PSS 서명 검증 필수 (보안 정책, 해제 불가)" IsEnabled="False" IsChecked="True" Margin="0,2,0,4"/>
                        <TextBlock Text="신뢰할 업데이트 공개 키 PEM 경로"/>
                        <TextBox x:Name="UpdatePublicKeyPathBox" Margin="0,4,0,6" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,8" Text="Private 저장소의 업데이트에는 각 PC의 CYANDECK_GITHUB_TOKEN 환경 변수가 필요합니다. RSA 공개키 PEM도 반드시 있어야 합니다. 원격 채널은 HTTPS만 허용하고 RSA-PSS 서명과 SHA-256 검증을 반드시 통과해야 설치됩니다. 로컬에 신뢰할 RSA 공개 키를 지정해야 합니다. 키 경로를 비우면 실행 파일 옆의 CyanDeck.update-public-key.pem을 사용합니다."/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="업데이트 확인 및 설치…" Margin="0,0,8,8" Click="CheckForUpdates_Click"/>
                            <Button Content="마지막 앱 업데이트 되돌리기…" Margin="0,0,8,8" Click="RollbackUpdate_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="LastUpdateCheckText" Foreground="#AEB8C6" Margin="0,0,0,5"/>
                        <TextBlock x:Name="UpdateFailureSummaryText" TextWrapping="Wrap" Foreground="#E6BE7A" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,13">
                            <Button x:Name="OpenUpdateFailureLogButton" Content="마지막 업데이트 오류 로그 보기" Margin="0,0,8,5" Click="OpenUpdateFailureLog_Click"/>
                            <Button Content="업데이트 진단 새로고침" Margin="0,0,8,5" Click="RefreshUpdateDiagnostics_Click"/>
                        </WrapPanel>

                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="AboutSection" Text="버전 정보" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AboutVersionText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AboutSchemaText" Foreground="#AEB8C6" Margin="0,0,0,10"/>
                        <Border Background="#20242B" BorderBrush="#3A424E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock x:Name="AboutModeText" TextWrapping="Wrap"/>
                        </Border>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AboutTab" Header="문제 해결·초기화">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="문제 해결·초기화" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="진단 도구, 안전 모드, 설정·위치 초기화와 다시 시작을 한곳에 모았습니다." Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="TroubleshootSection" Text="진단·복구 도구" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10" Text="안전 모드는 바탕화면 마우스 후크, Shell 부모 연결, 파일 감시, Windows 아이콘 변경 없이 CyanDeck을 실행합니다. Explorer 연동이나 손상된 설정 때문에 정상 시작이 어려울 때 사용합니다."/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="자체 테스트 실행…" Margin="0,0,8,8" Click="RunSelfTest_Click"/>
                            <Button Content="설정 검사 / 복구…" Margin="0,0,8,8" Click="AboutValidateConfiguration_Click"/>
                            <Button Content="진단 묶음 만들기…" Margin="0,0,8,8" Click="CreateDiagnosticBundle_Click"/>
                            <Button Content="진단 로그 열기" Margin="0,0,8,8" Click="OpenDiagnosticLogs_Click"/>
                            <Button Content="설정 감사 로그 열기" Margin="0,0,8,8" Click="OpenSettingsAuditLog_Click"/>
                            <Button Content="설정 폴더 열기" Margin="0,0,8,8" Click="OpenSettingsFolder_Click"/>
                        </WrapPanel>

                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="StartupSection" Text="안전 모드·시작 보호" Style="{StaticResource SectionTitle}"/>

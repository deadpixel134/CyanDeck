                            <TextBlock x:Name="StandaloneIconHoverOpacityText" DockPanel.Dock="Right" MinWidth="50" TextAlignment="Right"/>
                            <Slider x:Name="StandaloneIconHoverOpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StandaloneIconOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="StandaloneIconIncludeRecycleCheck" Content="단독 휴지통에도 위 투명도 적용" Margin="0,10,0,3"/>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,20" Text="끄면 일반 단독 아이콘은 불투명하게 유지됩니다. 휴지통에 적용하지 않으면 기존 그룹 카멜레온 설정을 따릅니다. 설정을 저장하면 즉시 반영됩니다. 그룹 내 아이콘과 캘린더는 변경하지 않습니다."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="RecycleSection" Text="휴지통 표시" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="StandaloneRecycleCheck" Content="바탕화면에 단독 휴지통 표시 (기본값: 켜짐)"/>
                        <TextBlock Text="CyanDeck 관리형 휴지통입니다. 바탕화면 아이콘을 숨기는 모드에서 그룹과 독립적으로 표시합니다. 빠른 숨김으로 자동 숨기지 않습니다." TextWrapping="Wrap" Foreground="#98A3B3" Margin="0,0,0,10"/>
                        <CheckBox x:Name="GroupRecycleCheck" Content="Windows 기본 아이콘 그룹에도 휴지통 표시 (기본값: 켜짐)"/>
                        <TextBlock Text="그룹의 휴지통은 별도의 바로가기입니다. 단독 휴지통을 숨기거나 위치를 바꾸지 않습니다. 기존 일반 그룹 및 사용자 지정 아이콘은 변경하지 않습니다." TextWrapping="Wrap" Foreground="#98A3B3" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="SystemGroupSection" Text="Windows 기본 아이콘 그룹" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <Button x:Name="AddSystemIconGroupButton" Content="Windows 기본 아이콘 그룹 추가" Click="AddSystemIconGroup_Click" Margin="0,0,8,8"/>
                            <Button x:Name="ResetStandaloneRecycleButton" Content="단독 휴지통 위치 초기화" Click="ResetStandaloneRecycleBin_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="내 PC · 사용자 폴더 · 네트워크 · 제어판 · 휴지통을 그룹에 표시합니다. 이미 기본 그룹이 있으면 새로 만들지 않습니다. Windows 자체 아이콘을 보려면 일반 설정의 'Windows 바탕화면 아이콘 숨기기'를 해제하세요." TextWrapping="Wrap" Foreground="#98A3B3" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- This is an Appearance subpage, not a competing sidebar root.
                 Keep the complete per-group editor isolated so the common
                 Appearance page remains compact and group draft/permission
                 boundaries retain their original owning TabItem. -->
            <TabItem x:Name="GroupsTab" Header="그룹 개별 편집">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="그룹 개별 편집" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="그룹을 선택한 뒤 해당 그룹의 배경색, 글꼴, 아이콘 배치와 제목줄을 조정합니다. 공통 모양은 모양 및 외관의 다른 항목에서 설정할 수 있습니다."
                                   Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10"
                                Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock x:Name="GroupEditorSection" Text="그룹 개별 편집" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="FencePicker" Width="360" HorizontalAlignment="Left" SelectionChanged="FencePicker_SelectionChanged"/>
                        <TextBlock Text="현재 그룹 프리셋" Margin="0,4,0,4"/>
                        <CheckBox x:Name="LinkedIconSpacingCheck" Content="그룹 안팎의 아이콘 간격을 동일하게 사용" Margin="0,6,0,2" Checked="LinkedIconSpacingCheck_Changed" Unchecked="LinkedIconSpacingCheck_Changed"/>
                        <TextBlock Foreground="#98A3B3" Text="켜면 그룹의 격자와 자유 배치 Pack/Snap이 그룹 밖 CyanDeck 바탕화면 아이콘과 같은 기본 간격을 사용합니다. 각 그룹에 저장된 기존 가로/세로 간격 값은 덮어쓰지 않으며, 끄면 즉시 복원됩니다." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="좁게" Margin="0,0,8,0" Click="CompactPreset_Click"/>
                            <Button Content="균형" Margin="0,0,8,0" Click="BalancedPreset_Click"/>
                            <Button Content="크게" Margin="0,0,8,0" Click="LargePreset_Click"/>
                            <Button Content="그룹 옵션 초기화" Margin="0" Click="ResetSelectedGroup_Click"/>
                        </StackPanel>

                        <Grid x:Name="GroupEditor" Width="560" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="30"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="아이콘 배치"/>
                                <ComboBox x:Name="IconLayoutCombo"/>
                                <TextBlock Text="아이콘 이름"/>
                                <ComboBox x:Name="IconLabelModeCombo"/>
                                <TextBlock Text="아이콘 이름 글자 크기" Margin="0,7,0,0"/>
                                <DockPanel><TextBlock x:Name="IconLabelFontSizeText" DockPanel.Dock="Right"/><Slider x:Name="IconLabelFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="IconLabelFontSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="아이콘 크기"/>
                                <DockPanel><TextBlock x:Name="IconSizeText" DockPanel.Dock="Right"/><Slider x:Name="IconSizeSlider" Minimum="24" Maximum="128" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="IconSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="가로 간격"/>
                                <DockPanel><TextBlock x:Name="SpacingXText" DockPanel.Dock="Right"/><Slider x:Name="SpacingXSlider" Minimum="0" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SpacingXSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="세로 간격"/>
                                <DockPanel><TextBlock x:Name="SpacingYText" DockPanel.Dock="Right"/><Slider x:Name="SpacingYSlider" Minimum="0" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SpacingYSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="배경색(HEX)" Margin="0,10,0,0"/>

                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="LoadingPerformanceSection" Text="불러오기·캐시" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipBorder}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="고급"/>
                                </Border>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="대부분 바꿀 필요가 없습니다. 항목이 많은 탭과 시작 속도, 메모리 사용을 조정합니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AsyncItemLoadingCheck" Content="항목이 많은 탭은 백그라운드에서 불러오기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="파일 미리보기가 켜져 있거나 폴더 포털이면 항상 백그라운드에서 불러옵니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AsyncItemLoadingCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="백그라운드 로딩 기준 (탭당 항목 수)"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="AsyncThresholdText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="AsyncThresholdSlider" AutomationProperties.Name="백그라운드 로딩 기준 (탭당 항목 수)" Minimum="20" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AsyncThresholdSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="DeferHiddenPageRenderingCheck" Content="시작할 때 다른 페이지 아이콘은 나중에 그리기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="다음 실행부터 적용됩니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="아이콘·미리보기 캐시 크기 (개수)"/>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconCacheText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <Slider x:Name="IconCacheSlider" AutomationProperties.Name="아이콘·미리보기 캐시 크기 (개수)" Minimum="128" Maximum="4096" TickFrequency="128" IsSnapToTickEnabled="True" ValueChanged="IconCacheSlider_ValueChanged"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="메모리의 아이콘·미리보기 캐시를 비웁니다. 표시 중인 그룹은 필요할 때 다시 채웁니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="아이콘 캐시 지금 비우기" Margin="0" Click="ClearIconCache_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="PerformanceSection" Text="저장 대기 시간" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipBorder}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="고급"/>
                                </Border>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="대부분 바꿀 필요가 없습니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="변경 후 저장까지 대기 시간"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="길게 하면 디스크 쓰기는 줄지만 비정상 종료 때 잃는 변경이 늘어납니다."/>

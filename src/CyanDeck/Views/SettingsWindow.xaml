                                        <CheckBox x:Name="CalendarModuleCheck" Content="바탕화면 캘린더 사용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="저장하면 다시 시작하지 않고 바로 켜지거나 꺼집니다. 날짜를 두 번 클릭해 일정을 입력합니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="보기 방식"/>
                                        <ComboBox x:Name="CalendarViewModeCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="보기 방식">
                                            <ComboBoxItem Content="오늘을 가운데에 표시 (주 단위)" Tag="Rolling"/>
                                            <ComboBoxItem Content="월 단위" Tag="Month"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="한 번에 보여줄 주 수"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="월 보기는 한 달이 모두 보이도록 자동으로 늘어납니다."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CalendarRowsCombo" Grid.Column="2" Style="{StaticResource RowCombo}" ItemStringFormat="{}{0}주" AutomationProperties.Name="한 번에 보여줄 주 수"/>
                                    </Grid>
                                </Border>
                                <!-- Never wrapped: the size-validation route jumps here and focuses CalendarWidthBox. -->
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="크기 (px)"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="너비 390 이상, 높이 310~1200. 캘린더 모서리를 끌어도 바뀝니다."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="너비" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="CalendarWidthBox" Width="72" Height="28" Padding="5,2" AutomationProperties.Name="캘린더 너비"/>
                                            <TextBlock Text="×" VerticalAlignment="Center" Foreground="#8F9AA8" Margin="10,0,10,0"/>
                                            <TextBlock Text="높이" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="CalendarHeightBox" Width="72" Height="28" Padding="5,2" AutomationProperties.Name="캘린더 높이"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="CalendarAppearanceSection" Text="글자·배경색" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="날짜·요일·월 제목 글자 크기"/>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=CalendarDateFontSizeSlider, StringFormat='{}{0:0} px'}"/>
                                            <Slider x:Name="CalendarDateFontSizeSlider" AutomationProperties.Name="날짜·요일·월 제목 글자 크기" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="일정 제목 글자 크기"/>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=CalendarEventFontSizeSlider, StringFormat='{}{0:0} px'}"/>
                                            <Slider x:Name="CalendarEventFontSizeSlider" AutomationProperties.Name="일정 제목 글자 크기" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="배경색 (#RRGGBB)"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="CalendarBackgroundColorBox" Width="110" Height="28" Padding="5,2" AutomationProperties.Name="배경색 (#RRGGBB)"/>
                                            <Button x:Name="CalendarBackgroundColorSwatch" Width="27" Height="25" MinHeight="0" Padding="0" Margin="7,0,0,0" AutomationProperties.Name="캘린더 배경색 선택" ToolTip="현재 색상 · 클릭해 컬러피커 표시"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="CalendarFadeSection" Text="캘린더 흐리게" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="마우스를 캘린더 밖으로 옮기면 배경이 흐려집니다. 편집 중이거나 일정 메뉴가 열려 있으면 선명하게 유지됩니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <CheckBox x:Name="CalendarChameleonCheck" Content="사용하지 않을 때 배경 흐리게"/>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=CalendarChameleonCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="흐릴 때 배경 불투명도"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=CalendarIdleOpacitySlider, StringFormat='{}{0:P0}'}"/>
                                                <Slider x:Name="CalendarIdleOpacitySlider" AutomationProperties.Name="흐릴 때 배경 불투명도" Minimum="0.15" Maximum="1" Value="0.38"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <!-- Outside the wrapper: this value is also used while the calendar fade is off. -->
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="사용 중(마우스를 올렸을 때·편집 중) 배경 불투명도"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="흐리게를 끄면 항상 이 값을 씁니다. 약 86%보다 높이면 차이가 거의 없습니다."/>
                                        </StackPanel>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=CalendarActiveOpacitySlider, StringFormat='{}{0:P0}'}"/>
                                            <Slider x:Name="CalendarActiveOpacitySlider" AutomationProperties.Name="사용 중(마우스를 올렸을 때·편집 중) 배경 불투명도" Minimum="0.15" Maximum="1" Value="0.86"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="GoogleSection" Text="Google 개발용 ID" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipBorder}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="고급"/>
                                </Border>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="대부분 바꿀 필요가 없습니다. Google 계정 연결과 동기화는 캘린더 창에서 합니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="사용자 지정 OAuth 클라이언트 ID"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="정식 배포판은 내장 클라이언트를 쓰므로 비워 두세요. 내장 클라이언트가 없는 개발용 빌드에서만 쓰입니다."/>
                                        <TextBox x:Name="GoogleClientIdBox" Height="30" Padding="7,3" Margin="0,8,0,0" AutomationProperties.Name="사용자 지정 OAuth 클라이언트 ID" ToolTip="Google Cloud Console에서 데스크톱 OAuth 클라이언트 ID를 입력하세요."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 모니터·백업 ============================== -->
            <TabItem x:Name="LayoutTab" Header="모니터·백업">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="모니터·백업" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="모니터 구성이 바뀔 때의 그룹 배치, 레이아웃 스냅샷, 백업 파일과 기본 구성 복원을 관리합니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="켜기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GeneralTab|FeaturesSection" Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>

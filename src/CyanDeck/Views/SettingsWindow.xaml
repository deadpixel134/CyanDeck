<Window x:Class="CyanDeck.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyanDeck 설정" Width="1040" Height="760"
        MinWidth="940" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#15171B" Foreground="#F2F4F8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
                <ResourceDictionary Source="../Themes/ReadableComboBoxes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Let labels inherit Window.Foreground. An implicit TextBlock foreground
                 overrides ComboBoxItem.Foreground inside the native dropdown and
                 creates light-on-light unreadable entries. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}"><Setter Property="Margin" Value="0,7"/></Style>
            <Style TargetType="Label"><Setter Property="Foreground" Value="#AEB8C6"/></Style>
            <!-- Keep the native WPF ComboBox/Popup template to preserve mouse capture.
                 Only the item containers use a deterministic accessible palette. -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource ReadableComboBoxStyle}">
                <Setter Property="Margin" Value="0,4,0,10"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource DarkSliderStyle}"><Setter Property="Margin" Value="0,3,0,12"/></Style>
            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}"><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#E9F1FC"/><Setter Property="Margin" Value="0,2,0,17"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SettingsSearchBox" Height="32" Padding="9,4" TextChanged="SettingsSearchBox_TextChanged" KeyDown="SettingsSearchBox_KeyDown" AutomationProperties.Name="설정 검색"
                         ToolTip="설정 이름이나 설명의 낱말로 찾습니다. Enter: 다음 결과 · Esc: 검색 지우기"/>
                <TextBlock Text="설정 검색 (예: 휴지통, 투명도, 업데이트, 시작 시 실행)" Margin="10,0,0,0" Foreground="#778391" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock x:Name="SettingsSearchHint" Grid.Column="1" Margin="10,0,0,0" Foreground="#98A3B3" VerticalAlignment="Center"/>
        </Grid>
        <!-- Category navigation replaces the crowded horizontal tabs. The original
             settings editors remain intact; tree leaves scroll to named sections. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1D222B" BorderBrush="#343A44" BorderThickness="1" CornerRadius="8" Padding="6,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="설정 분류" FontSize="14" FontWeight="SemiBold"
                               Foreground="#D7E3F2" Margin="10,2,0,12"/>
                    <TreeView x:Name="SettingsNavigation" Background="Transparent" Foreground="#EAF0F8"
                              BorderThickness="0" SelectedItemChanged="SettingsNavigation_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="설정 분류 트리">
                        <TreeView.Resources>
                            <!-- Every category stays open so no setting is hidden behind a collapsed node.
                                 Category rows override weight/colour locally; leaves use this style. -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#EAF0F8"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Padding" Value="3,4"/>
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeViewItem x:Name="NavGeneral" Header="기본 설정" Tag="GeneralTab|FeaturesSection" FontWeight="SemiBold" Foreground="#9DB4CF">
                            <TreeViewItem Header="기능 켜기·끄기" Tag="GeneralTab|FeaturesSection"/>
                            <TreeViewItem Header="시작·바탕화면 아이콘" Tag="GeneralTab|DesktopSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="그룹 모양" Tag="AppearanceTab|DesktopIconStyleSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="아이콘 표시 방식" Tag="AppearanceTab|DesktopIconStyleSection"/>
                            <TreeViewItem Header="제목줄·버튼·스크롤바" Tag="AppearanceTab|GroupChromeSection"/>
                            <TreeViewItem Header="흐리게·투명도 (카멜레온)" Tag="AppearanceTab|ChameleonSection"/>
                            <TreeViewItem Header="그룹 개별 편집" Tag="GroupsTab|GroupEditorSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="바탕화면 아이콘·휴지통" Tag="SystemIconsTab|StandaloneSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="그룹 밖 아이콘 투명도" Tag="SystemIconsTab|StandaloneSection"/>
                            <TreeViewItem Header="휴지통 표시" Tag="SystemIconsTab|RecycleSection"/>
                            <TreeViewItem Header="Windows 기본 아이콘 그룹" Tag="SystemIconsTab|SystemGroupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="마우스·터치 조작" Tag="InteractionTab|GesturesSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="페이지 전환 제스처" Tag="InteractionTab|GesturesSection"/>
                            <TreeViewItem Header="빈 바탕화면에서 그룹 만들기" Tag="InteractionTab|CreateGroupSection"/>
                            <TreeViewItem Header="그룹 맞춤·스냅" Tag="InteractionTab|SnapSection"/>
                            <TreeViewItem Header="탭 그룹" Tag="InteractionTab|TabsSection"/>
                            <TreeViewItem Header="그룹 접기" Tag="InteractionTab|RollupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Peek·빠른 숨김" Tag="PeekTab|PeekSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="Peek·핫 코너" Tag="PeekTab|PeekSection"/>
                            <TreeViewItem Header="빠른 숨김" Tag="PeekTab|QuickHideSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="애니메이션" Tag="AnimationTab|PageAnimationSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="페이지 전환 효과" Tag="AnimationTab|PageAnimationSection"/>
                            <TreeViewItem Header="아이콘 이동 효과" Tag="AnimationTab|ItemAnimationSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="캘린더" Tag="CalendarTab|CalendarSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="크기와 보기 방식" Tag="CalendarTab|CalendarSection"/>
                            <TreeViewItem Header="글자와 배경" Tag="CalendarTab|CalendarAppearanceSection"/>
                            <TreeViewItem Header="Google 연결" Tag="CalendarTab|GoogleSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="레이아웃·백업" Tag="LayoutTab|SnapshotsSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="모니터 배치·스냅샷" Tag="LayoutTab|SnapshotsSection"/>
                            <TreeViewItem Header="백업 내보내기·가져오기" Tag="LayoutTab|BackupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="성능" Tag="PerformanceTab|PerformanceSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="저장과 드래그" Tag="PerformanceTab|PerformanceSection"/>
                            <TreeViewItem Header="대량 작업·캐시" Tag="PerformanceTab|LoadingPerformanceSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="업데이트·정보" Tag="UpdatesTab|UpdatesSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="업데이트" Tag="UpdatesTab|UpdatesSection"/>
                            <TreeViewItem Header="버전 정보" Tag="UpdatesTab|AboutSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="문제 해결·초기화" Tag="AboutTab|TroubleshootSection" FontWeight="SemiBold" Foreground="#9DB4CF" Margin="0,6,0,1">
                            <TreeViewItem Header="진단·복구 도구" Tag="AboutTab|TroubleshootSection"/>
                            <TreeViewItem Header="안전 모드·시작 보호" Tag="AboutTab|StartupSection"/>
                            <TreeViewItem Header="설정 기본값 복원" Tag="AboutTab|ResetSection"/>
                            <TreeViewItem Header="위치·전체 초기화" Tag="AboutTab|FactoryResetSection"/>
                            <TreeViewItem Header="다시 시작" Tag="AboutTab|RestartSection"/>
                            <TreeViewItem Header="관리 정책" Tag="AboutTab|PolicySection"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>
            <TabControl x:Name="SettingsTabs" Grid.Column="2" Background="#1B1E24" BorderBrush="#343A44">
                <!-- Retain TabItems as edit views, but remove the competing top navigation. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

            <TabItem x:Name="GeneralTab" Header="일반 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="일반 설정" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="기능 활성화, 시작 동작 및 바탕화면 항목 분류를 설정합니다." Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="FeaturesSection" Text="기능 켜기·끄기" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="DeckModuleCheck" Content="CyanDeck 그룹·아이콘 관리 켜기"/>
                        <CheckBox x:Name="CalendarModuleCheck" Content="바탕화면 캘린더 켜기 (날짜 더블클릭으로 입력)"/>
                        <TextBlock Text="CyanDeck 기능 전환은 셸 훅을 안전하게 정리하기 위해 프로그램을 자동 재시작합니다. 캘린더는 바로 켜고 끌 수 있습니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="DesktopSection" Text="시작·바탕화면 아이콘" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="HideNativeIconsCheck" Content="CyanDeck 실행 중 Windows 바탕화면 아이콘 숨기기"/>
                        <CheckBox x:Name="AutoImportCheck" Content="Windows 바탕화면의 항목을 자동으로 가져오기"/>
                        <TextBlock Text="새 바탕화면 항목 기본 위치" Margin="0,7,0,0"/>
                        <ComboBox x:Name="DefaultDesktopPlacementCombo" Width="360" HorizontalAlignment="Left" SelectionChanged="DefaultDesktopPlacementCombo_SelectionChanged" AutomationProperties.Name="새 바탕화면 항목 기본 위치"/>
                        <CheckBox x:Name="ActivateDefaultDestinationTabCheck" Content="새 항목이 배치되면 대상 탭 활성화"/>
                        <CheckBox x:Name="LeaveNewDesktopItemsCheck" Content="새로 생긴 바탕화면 항목은 그룹 밖 바탕화면 아이콘으로 유지" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <TextBlock Foreground="#98A3B3" Text="기본값인 자동 분류는 기존 규칙/파일 종류 분류를 유지합니다. ‘그룹 밖 바탕화면’을 선택하면 새 항목을 CyanDeck 바탕화면 아이콘으로 남기며, 특정 ‘그룹 / 탭’을 선택하면 명시적 규칙에 맞지 않는 새 항목만 그 탭으로 보냅니다. Folder Portal은 목적지로 사용할 수 없습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="KeepRulesUpdatedCheck" Content="자동 분류 규칙을 항상 최신 상태로 유지"/>
                        <Button Content="자동 분류 규칙 지금 실행" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ApplyRulesNow_Click"
                                ToolTip="저장된 자동 분류 규칙으로 바탕화면 항목을 지금 정리합니다."/>
                        <CheckBox x:Name="TrackDesktopLocationCheck" Content="실행 중 바탕화면 폴더 위치 변경 추적"/>
                        <TextBlock Foreground="#98A3B3" Text="OneDrive, Explorer, 그룹 정책 또는 알려진 폴더 설정으로 바탕화면 위치가 바뀌면 감시 경로를 자동으로 다시 연결합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 CyanDeck 실행"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="InteractionTab" Header="마우스·터치 조작">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="마우스·터치 조작" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="바탕화면 페이지를 넘기는 제스처, 빈 바탕화면에서 그룹 만들기, 그룹 맞춤·스냅, 탭 그룹과 그룹 접기를 설정합니다. 왼쪽 목록의 항목마다 아래 카드가 하나씩 있습니다." Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <!-- One card per sidebar entry, titled exactly like the entry. -->
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="GesturesSection" Text="페이지 전환 제스처" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="EdgeGesturesCheck" Content="바탕화면 페이지 가장자리/스와이프 제스처 사용"/>
                        <CheckBox x:Name="InteriorSeamGesturesCheck" Content="모니터 사이 경계에서도 가장자리 페이지 제스처 허용" IsEnabled="{Binding IsChecked, ElementName=EdgeGesturesCheck}"/>
                        <TextBlock Foreground="#98A3B3" Text="기본값은 모니터 사이의 연속된 경계를 차단하고 실제 바탕화면 바깥쪽 가장자리에서만 전환합니다. 세로로 어긋난 모니터는 실제로 맞닿은 구간만 내부 경계로 판단합니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="TouchPageGesturesCheck" Content="두 손가락 터치 스와이프로 바탕화면 페이지 전환"/>
                        <TextBlock Foreground="#98A3B3" Text="직접 터치 페이지 전환은 빈 바탕화면 입력 표면을 사용합니다. Windows 아이콘의 터치 입력을 방해하지 않도록 Windows 바탕화면 아이콘을 숨길 때만 활성화됩니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="TouchIconFlickCheck" Content="터치로 아이콘을 그룹에 튕겨 넣기"/>
                        <TextBlock Foreground="#98A3B3" Text="터치스크린에서 그룹 밖 아이콘을 원하는 일반 그룹 방향으로 빠르게 튕기면 CyanDeck 참조를 그 그룹의 현재 탭으로 이동합니다. 느린 탭/드래그와 Folder Portal은 영향을 받지 않으며 기본값은 꺼짐입니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <CheckBox x:Name="PageAltWheelCheck" Content="Alt + 마우스 휠로 바탕화면 페이지 전환"/>
                        <CheckBox x:Name="PageMiddleDragCheck" Content="마우스 가운데 버튼 드래그로 바탕화면 페이지 전환"/>
                        <CheckBox x:Name="PageBothButtonsDragCheck" Content="마우스 왼쪽+오른쪽 버튼 드래그로 바탕화면 페이지 전환"/>
                        <TextBlock Foreground="#E3B86A" Text="그룹이 갑자기 사라진 것처럼 보이면 다른 바탕화면 페이지로 이동했거나 빠른 숨김이 켜졌을 수 있습니다. 트레이 메뉴의 ‘표시 상태 복구’는 빠른 숨김을 해제하고 그룹이 있는 가까운 페이지로 돌아갑니다." TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="CreateGroupSection" Text="빈 바탕화면에서 그룹 만들기" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="바탕화면의 빈 곳을 아래에서 고른 마우스 버튼으로 누른 채 끌어 사각형을 그리고 놓으면 '여기에 새 그룹 만들기'와 '여기에 Folder Portal 만들기…' 메뉴가 열립니다. 그린 사각형의 위치와 크기 그대로 새 그룹이 만들어집니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="사각형을 그릴 마우스 버튼"/>
                        <ComboBox x:Name="CreateGroupMouseButtonCombo" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="빈 바탕화면에서 사각형을 그릴 마우스 버튼"/>
                        <TextBlock Foreground="#98A3B3" Text="짧게 누르는 왼쪽 클릭과 우클릭은 평소처럼 바탕화면으로 전달되고, 끌기 시작할 때만 그룹 만들기로 바뀝니다. Alt/Ctrl/Shift/Win 키를 누르고 있거나 왼쪽과 오른쪽 버튼을 함께 누르면 사용하지 않습니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <TextBlock Foreground="#98A3B3" Text="'왼쪽 버튼'이 포함된 방식을 고르면, 빈 바탕화면을 왼쪽 버튼으로 끌어 아이콘을 범위 선택하는 대신 그룹 만들기가 됩니다." TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <TextBlock Foreground="#98A3B3" Text="Peek·빠른 숨김·바탕화면 보기 중이거나, 안전 모드, 화면 구성이 바뀌는 중, 관리 정책으로 그룹 만들기가 막혀 있을 때는 동작하지 않습니다." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="SnapSection" Text="그룹 맞춤·스냅" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="SmartSnapCheck" Content="그룹 간격과 가장자리를 일정하게 맞춤"/>

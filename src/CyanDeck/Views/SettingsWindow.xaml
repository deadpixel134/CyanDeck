                    <StackPanel Margin="28,24,26,38" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="바탕화면 아이콘·휴지통" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7FD" Margin="0,0,0,8"/>
                        <TextBlock Text="그룹 밖에 둔 바탕화면 아이콘의 투명도, 휴지통, 내 PC·네트워크 같은 Windows 기본 아이콘을 설정합니다." Foreground="#AAB9C9" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <Border x:Name="StandaloneAppearanceCard" Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="StandaloneSection" Text="그룹 밖 아이콘 투명도" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="StandaloneIconChameleonCheck" Content="그룹 밖 아이콘도 마우스가 멀어지면 흐리게 (카멜레온, 그룹과 따로 설정)" Margin="0,4,0,6"/>
                        <TextBlock Text="커서가 없을 때 불투명도 (15~100%)" Margin="0,5,0,3"/>
                        <DockPanel Width="380" HorizontalAlignment="Left">
                            <TextBlock x:Name="StandaloneIconIdleOpacityText" DockPanel.Dock="Right" MinWidth="50" TextAlignment="Right"/>
                            <Slider x:Name="StandaloneIconIdleOpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StandaloneIconOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Text="커서를 올렸을 때 불투명도 (15~100%)" Margin="0,8,0,3"/>

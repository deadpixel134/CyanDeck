                            <TextBlock Text="높이" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="CalendarHeightBox" Width="72" Height="28" Padding="5,2"/>
                        </StackPanel>
                        <TextBlock Text="보기 방식" Margin="0,7,0,4"/>
                        <ComboBox x:Name="CalendarViewModeCombo" Width="280" HorizontalAlignment="Left">
                            <ComboBoxItem Content="오늘을 가운데에 표시 (주 단위)" Tag="Rolling"/>
                            <ComboBoxItem Content="월 단위" Tag="Month"/>
                        </ComboBox>
                        <TextBlock Text="한 번에 보여줄 주 수 (월 단위는 한 달이 모두 보이도록 자동으로 늘어남)" Margin="0,5,0,3" TextWrapping="Wrap"/>

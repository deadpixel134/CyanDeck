                                        <TextBox x:Name="UpdatePublicKeyPathBox" Margin="0,8,0,0" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E" AutomationProperties.Name="사용자 지정 서명 공개 키 파일 (PEM)"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="RequireSignedUpdateCheck" Content="업데이트 서명 검증 (항상 켜짐)" IsEnabled="False" IsChecked="True"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">

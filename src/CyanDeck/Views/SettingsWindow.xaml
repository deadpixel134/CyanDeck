                                            <Slider x:Name="SaveDebounceSlider" AutomationProperties.Name="변경 후 저장까지 대기 시간" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SaveDebounceSlider_ValueChanged"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 업데이트·정보 (no policy gate) ============================== -->
            <TabItem x:Name="UpdatesTab" Header="업데이트·정보">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="업데이트·정보" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="현재 버전을 확인하고 새 버전 확인·설치 방식을 정합니다. 관리 정책과 관계없이 항상 열 수 있습니다." Style="{StaticResource PageDescription}"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="AboutSection" Text="버전·업데이트 확인" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusBox}" Margin="0">
                                        <StackPanel>
                                            <TextBlock x:Name="AboutVersionText" FontSize="16" FontWeight="SemiBold"/>

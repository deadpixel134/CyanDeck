                                <TextBlock Text="제목 글꼴 크기"/>
                                <DockPanel><TextBlock x:Name="TitleFontSizeText" DockPanel.Dock="Right"/><Slider x:Name="TitleFontSizeSlider" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TitleFontSizeSlider_ValueChanged"/></DockPanel>
                                <TextBlock Text="제목 색상(HEX)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBox x:Name="TitleColorBox" Width="130" Padding="6,4" VerticalContentAlignment="Center" ToolTip="#RRGGBB · 유효한 HEX 입력은 자동 반영"/>
                                    <Button x:Name="TitleColorSwatch" Width="27" Height="25" MinHeight="0" Padding="0" Margin="7,0,0,0" ToolTip="현재 색상 · 클릭해 컬러피커 표시"/>
                                </StackPanel>
                                <TextBlock Text="접힌 그룹 열기 방식"/>
                                <ComboBox x:Name="RollupModeCombo"/>
                                <TextBlock Text="마우스 오버 지연"/>
                                <DockPanel><TextBlock x:Name="HoverDelayText" DockPanel.Dock="Right"/><Slider x:Name="HoverDelaySlider" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="HoverDelaySlider_ValueChanged"/></DockPanel>
                                <CheckBox x:Name="LockedCheck" Margin="0,16,0,0" Content="그룹 위치와 크기 잠금"/>
                                <CheckBox x:Name="TitlebarBottomNearTopCheck" Content="그룹이 화면 위쪽에 가까우면 제목 표시줄을 아래로 이동"/>
                                <TextBlock Margin="0,16,0,0" Foreground="#98A3B3" TextWrapping="Wrap"

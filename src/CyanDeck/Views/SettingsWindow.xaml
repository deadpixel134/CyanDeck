                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Holds the chosen path for save and the unsaved-change signature; never shown or searched. -->
                                    <TextBox x:Name="PeekTaskbarIconPathBox" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                             TextChanged="PeekTaskbarIconPathBox_TextChanged"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="EndPeekAfterLaunchCheck" Content="Peek에서 항목을 열면 Peek 자동으로 끝내기"/>

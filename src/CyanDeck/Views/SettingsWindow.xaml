                        <TextBlock Text="캘린더" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="바탕화면 캘린더를 켜고 보기 방식, 크기, 글자, 배경과 흐리게를 정합니다. 공휴일·동기화·Google 계정은 캘린더 창의 설정에서 바꿉니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=CalendarModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <TextBlock Text="캘린더가 꺼져 있습니다. 설정은 저장되고 캘린더를 켜면 적용됩니다." Foreground="#E3C88A" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">

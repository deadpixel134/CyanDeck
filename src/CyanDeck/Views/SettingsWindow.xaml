                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="모니터 구성이 바뀌면"/>
                                        <ComboBox x:Name="LayoutAdjustmentCombo" Width="300" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="모니터 구성이 바뀌면"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="연결된 두 모니터를 선택해 그룹과 그룹 밖 아이콘의 화면 위치를 서로 교환합니다. 파일 자체는 이동하지 않으며 실행 전 복구 지점을 만듭니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="SwapScreenContentsButton" Content="화면 내용 교환…" Margin="0" Click="SwapScreenContents_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="지금 위치는 그대로이며 다음 모니터 변경부터 현재 배치를 기준으로 씁니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="모니터별로 기억한 배치 지우기…" Margin="0" Click="ResetMonitorLayouts_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="SnapshotsSection" Text="레이아웃 스냅샷" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="스냅샷은 트레이 → 그룹 및 화면 → 레이아웃 스냅샷에서 만들고 복원합니다. 보관 개수를 줄이고 저장하면 오래된 것부터 바로 지워집니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AutomaticSnapshotsCheck" Content="하루 한 번 자동 배치 스냅샷 만들기 (위치·크기만)"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="그룹 위치와 크기만 저장합니다. 지운 그룹이나 탭은 아래 '복구 지점'이나 트레이 → 백업 및 복구 → 백업 / 복원 → 복구 체크포인트에서 되살리세요."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AutomaticSnapshotsCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="보관할 자동 스냅샷 수"/>

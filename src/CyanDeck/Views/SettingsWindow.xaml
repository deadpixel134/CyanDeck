                        <TextBlock Foreground="#98A3B3" Text="큰 목록과 파일 미리보기는 UI 스레드 밖에서 준비합니다. 제한된 캐시로 장시간 사용 시 메모리 증가를 억제합니다." TextWrapping="Wrap" Margin="0,-3,0,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LayoutTab" Header="레이아웃·백업">

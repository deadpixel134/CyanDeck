                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AutomaticUpdateCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <CheckBox x:Name="InstallUpdatesAutomaticallyCheck" Content="시작할 때 새 버전 자동 설치"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="검증된 새 버전이 있으면 바탕화면이 뜨기 전에 설치하고 다시 시작합니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="BetaUpdateChannelCheck" Content="베타 버전도 받기"/>

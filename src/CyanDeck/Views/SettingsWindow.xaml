                                <TextBlock Style="{StaticResource SectionDescription}" Text="대부분 바꿀 필요가 없습니다. 잘못 넣으면 모든 업데이트 확인이 실패합니다. 원격 업데이트는 HTTPS여야 하며 항상 서명과 SHA-256으로 검증됩니다."/>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=BetaUpdateChannelCheck}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="사용자 지정 업데이트 주소"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="HTTPS 주소나 로컬 경로입니다. 비우면 기본 채널을 씁니다."/>
                                            <TextBox x:Name="UpdateManifestSourceBox" Margin="0,8,0,0" Padding="7,5" Background="#20242B" Foreground="#F2F4F8" BorderBrush="#3A424E" AutomationProperties.Name="사용자 지정 업데이트 주소"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,0,0,6" Text="참고: 베타를 켜면 무시됩니다">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowNote}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=BetaUpdateChannelCheck}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource SettingRow}">

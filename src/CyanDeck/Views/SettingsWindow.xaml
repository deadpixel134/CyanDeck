                        <DockPanel><TextBlock x:Name="CrashLoopWindowText" DockPanel.Dock="Right"/><Slider x:Name="CrashLoopWindowSlider" Minimum="2" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CrashLoopWindowSlider_ValueChanged"/></DockPanel>
                        <TextBlock x:Name="StartupHealthText" Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,-4,0,8"/>
                        <Button Content="시작 상태 기록 초기화" HorizontalAlignment="Left" Margin="0,0,0,16" Click="ResetStartupHealth_Click"/>

                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="ResetSection" Text="설정 기본값 복원" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="이 창의 설정 값을 모두 기본값으로 채웁니다. 그룹·아이콘·일정은 바뀌지 않으며, 아래쪽 '저장'을 눌러야 적용됩니다. 저장하지 않고 닫으면 원래 값이 유지됩니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="ResetGeneralButton" Content="일반 설정 기본값 복원" HorizontalAlignment="Left" Click="ResetGeneral_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="FactoryResetSection" Text="위치·전체 초기화" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="모든 그룹 창(데스크톱의 모든 페이지)과 캘린더 창의 위치·크기를 한 번에 기본 배치로 복원합니다. 그룹·아이콘·일정과 기타 설정은 그대로 두며, 기존 배치를 백업합니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,9"/>
                        <Button x:Name="ResetAllWindowGeometryButton" Content="모든 그룹·캘린더 창 위치 및 크기 초기화…" HorizontalAlignment="Left" Margin="0,0,0,18" Click="ResetAllWindowGeometry_Click"/>
                        <Separator Margin="0,0,0,12" Background="#344254"/>
                        <TextBlock Text="삭제된 기본 그룹이나 빠진 아이콘까지 되돌리려면 아래 초기 구성 복원을 사용하세요. 이 작업은 그룹 구성을 새로 만듭니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,10">
                            <CheckBox x:Name="ResetGroupGeometryCheck" Content="그룹 및 아이콘 초기 구성 복원 (삭제된 그룹·빠진 아이콘 다시 불러오기)" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ResetCalendarGeometryCheck" Content="캘린더 창 위치·크기 초기화" IsChecked="True" Margin="0,0,0,8"/>
                        </StackPanel>
                        <Button x:Name="ResetPlacementButton" Content="선택한 항목 초기 설정으로 복원…" HorizontalAlignment="Left" Margin="0,0,0,18" Click="ResetPlacement_Click"
                                Style="{StaticResource DeckDangerButtonStyle}"/>
                        <Separator Margin="0,0,0,12" Background="#344254"/>
                        <TextBlock Text="그룹 초기 구성 복원은 사용자 지정 그룹·탭·폴더 포털과 분류 규칙을 기본 구성으로 교체합니다(실제 파일 삭제 없음). 아래 전체 초기화는 프로그램 설정까지 초기화합니다. 두 작업 모두 복구 백업을 남깁니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="그룹·레이아웃과 CyanDeck 설정을 초기 상태로 복원합니다. 초기화 전에 원본 설정을 별도 백업합니다. 실제 파일·폴더, 로컬 캘린더 일정, Google 로그인 토큰, 캘린더 계정 데이터는 삭제하지 않습니다. 완료 후 프로그램이 다시 시작됩니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="FactoryResetButton" Content="전체 프로그램 설정 및 그룹 초기화…" HorizontalAlignment="Left" Margin="0,0,0,18" Click="FactoryReset_Click"
                                Style="{StaticResource DeckDangerButtonStyle}"/>
                        <Separator Margin="0,0,0,12" Background="#344254"/>
                        <TextBlock Text="완전 초기화는 이 PC의 CyanDeck 설정·그룹·로컬 일정·Google 로그인 토큰·연결 정보·백업·스냅샷·로그를 삭제합니다. 복구용 백업을 자동 생성하지 않습니다. Google 서버 일정, 바탕화면 원본 파일, 설치된 프로그램은 삭제하지 않습니다. 앱을 종료해 자료를 삭제한 후 첫 실행 설정을 다시 시작합니다." Foreground="#E5B8A7" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="CompleteLocalResetButton" Content="모든 CyanDeck 사용자 데이터 완전 초기화…" HorizontalAlignment="Left" Margin="0,0,0,18" Click="CompleteLocalReset_Click"
                                Style="{StaticResource DeckDangerButtonStyle}"/>

                            </StackPanel>
                        </Border>

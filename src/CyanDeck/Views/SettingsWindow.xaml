                            <Button Content="안전 모드로 다시 시작" Margin="0,0,8,8" Click="RestartSafeMode_Click"/>
                            <Button x:Name="RestartNormalButton" Content="일반 모드로 다시 시작" Margin="0,0,8,8" Click="RestartNormal_Click"/>
                        </WrapPanel>
                        <TextBlock Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,6,0,0" Text="더 새로운 CyanDeck 스키마의 설정 파일은 자동으로 덮어쓰지 않습니다. 호환성 폴더에 보존해 새 버전에서 복구할 수 있도록 합니다."/>
                            </StackPanel>

                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

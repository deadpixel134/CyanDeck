                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SnapshotScreenPreviewCheck" Content="수동 스냅샷에 화면 미리보기 저장"/>
                                </Border>
                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="화면 미리보기에는 다른 앱의 내용이 포함될 수 있어 개인정보 보호에 민감합니다. 두 미리보기 모두 기본값은 꺼짐입니다."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">

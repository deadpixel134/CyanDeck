                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="숨길 대상"/>
                                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="'항상 표시' 그룹과 휴지통은 숨기지 않습니다. 그룹 밖 아이콘 하나는 오른쪽 클릭으로 제외할 수 있습니다."/>
                                            </StackPanel>
                                            <ComboBox x:Name="QuickHideModeCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="숨길 대상"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="UnhideOnPageSwitchCheck" Content="페이지를 넘기면 숨긴 항목 다시 표시"/>
                                    </Border>
                                    <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <StackPanel>
                                            <CheckBox x:Name="QuickHideStartupShowCheck" Content="시작할 때 남은 숨김 상태 풀기"/>

                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="CalendarSection" Text="크기와 보기 방식" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="캘린더 크기 (px · 캘린더 모서리를 드래그해도 조절됩니다 · 너비 상한 없음)" Margin="0,0,0,4" TextWrapping="Wrap"/>

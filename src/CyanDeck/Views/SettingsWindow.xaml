                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=PeekHotCornerCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="왼쪽 클릭"/>
                                            <ComboBox x:Name="PeekHotCornerLeftCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="왼쪽 클릭"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="오른쪽 클릭"/>
                                            <ComboBox x:Name="PeekHotCornerRightCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="오른쪽 클릭"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="핫 코너 감지 두께"/>
                                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="고해상도나 터치 화면에서 누르기 어렵다면 두껍게 하세요. 기본 10px."/>
                                            </StackPanel>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="PeekHotCornerThicknessText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="PeekHotCornerThicknessSlider" AutomationProperties.Name="핫 코너 감지 두께" Minimum="4" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PeekHotCornerThicknessSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="PeekTaskbarButtonCheck" Content="작업 표시줄에 Peek 버튼 추가"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="누르면 Peek을 켜고 끕니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=PeekTaskbarButtonCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="작업 표시줄 버튼 아이콘"/>
                                                <TextBlock x:Name="PeekTaskbarIconPathText" Style="{StaticResource RowNote}" Margin="0,2,0,0" Text="기본 아이콘"/>
                                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="이 PC에 있는 4MB 이하 .ico 파일만 쓸 수 있습니다(네트워크 경로는 안 됨). 파일을 읽을 수 없으면 기본 아이콘을 씁니다."/>

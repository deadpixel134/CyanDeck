                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" Content="업데이트 확인 및 설치…" Style="{StaticResource DeckPrimaryButtonStyle}" VerticalAlignment="Center" Click="CheckForUpdates_Click"/>

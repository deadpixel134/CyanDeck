                                                <TextBlock x:Name="PageDurationText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="PageDurationSlider" AutomationProperties.Name="전환 시간" Minimum="80" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="PageDurationSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <StackPanel>
                                            <CheckBox x:Name="EnhancedPageEasingCheck" Content="가감속 곡선 사용"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="끄면 일정한 속도로 움직입니다."/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=EnhancedPageEasingCheck}">
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitle}" Text="움직임 느낌"/>
                                                    <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="부드럽게는 자연스럽게 감속하고, 빠르게는 더 즉각적으로 정착하며, 완만하게는 시작과 끝을 모두 부드럽게 만듭니다."/>
                                                </StackPanel>
                                                <ComboBox x:Name="PageEasingProfileCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="움직임 느낌"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRow}">
                                            <StackPanel>
                                                <CheckBox x:Name="BouncePagesCheck" Content="끝에서 살짝 튕기기"/>
                                                <TextBlock Style="{StaticResource RowDescription}" Text="켜면 위 '움직임 느낌' 대신 튕김 곡선을 씁니다."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Peek·빠른 숨김 ============================== -->
            <TabItem x:Name="PeekTab" Header="Peek·빠른 숨김">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Peek·빠른 숨김" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="바탕화면을 잠깐 비우는 빠른 숨김과, 열린 창 위로 그룹을 꺼내 보는 Peek을 설정합니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="켜기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GeneralTab|FeaturesSection" Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">

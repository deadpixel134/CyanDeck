                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TroubleshootSection" Text="진단·복구 도구" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="문제가 생기면 먼저 검사하고, 버그를 신고할 때는 진단 파일을 첨부하세요."/>
                                <TextBlock Style="{StaticResource SubsectionTitle}" Text="검사"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="PowerShell, 모니터, 바탕화면 폴더, 탐색기, 업데이트 키 상태를 확인합니다. 아무것도 바꾸지 않습니다."/>
                                        <Button Grid.Column="2" Content="환경 자체 검사" Margin="0" VerticalAlignment="Center" Click="RunSelfTest_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="그룹과 레이아웃 데이터를 검사하고, 문제가 있으면 복구 지점을 만든 뒤 고칩니다."/>
                                        <Button Grid.Column="2" Content="그룹 데이터 검사·복구" Margin="0" VerticalAlignment="Center" Click="AboutValidateConfiguration_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource SubsectionTitle}" Text="파일·로그"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="버그 신고용 로그와 요약을 개인 경로를 가린 채 ZIP으로 저장합니다."/>
                                        <Button Grid.Column="2" Content="진단 파일(ZIP) 만들기…" Margin="0" VerticalAlignment="Center" Click="CreateDiagnosticBundle_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <WrapPanel>
                                        <Button Content="진단 로그 폴더 열기" Margin="0,0,8,4" Click="OpenDiagnosticLogs_Click"/>
                                        <Button Content="설정 변경 기록 열기" Margin="0,0,8,4" Click="OpenSettingsAuditLog_Click"/>
                                    </WrapPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="레이아웃, 백업, 스냅샷이 저장된 폴더를 엽니다."/>
                                        <Button Grid.Column="2" Content="데이터 폴더 열기" Margin="0" VerticalAlignment="Center" Click="OpenSettingsFolder_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource SubsectionTitle}" Text="도움말"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="사각형으로 그룹 만들기, Alt+폴더 끌어 놓기, 페이지 제스처, 빠른 숨김 더블클릭, 그룹 단축키를 한눈에 봅니다."/>
                                        <Button x:Name="OpenInputGuideButton" Grid.Column="2" Content="단축키·제스처 안내…" Margin="0" VerticalAlignment="Center" Click="OpenInputGuide_Click"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="8" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                                    <TextBlock Foreground="#E3B86A" TextWrapping="Wrap" Text="그룹이 갑자기 사라진 것처럼 보이면 다른 바탕화면 페이지로 이동했거나 빠른 숨김이 켜졌을 수 있습니다. 트레이 메뉴의 ‘표시 상태 복구’는 빠른 숨김을 해제하고 그룹이 있는 가까운 페이지로 돌아갑니다."/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="RestartSection" Text="안전 모드·다시 시작" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource StatusBox}">
                                    <TextBlock x:Name="AboutModeText" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="바탕화면 마우스 후크, 파일 감시, Windows 아이콘 변경 없이 실행합니다. 탐색기 연동이나 손상된 설정 때문에 정상 시작이 안 될 때 사용합니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="안전 모드로 다시 시작" Style="{StaticResource DeckWarningButtonStyle}" Margin="0" Click="RestartSafeMode_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="실행 후 다시 시작"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="안전 모드에서만 쓸 수 있습니다. 이번 시작에 한해 시작 보호를 건너뜁니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="RestartNormalButton" Content="일반 모드로 다시 시작" Margin="0" Click="RestartNormal_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="실행 후 다시 시작"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AboutSchemaText" FontSize="12" Foreground="#8F9AA8" Margin="0,10,0,0"/>
                                <TextBlock FontSize="12" Foreground="#8F9AA8" TextWrapping="Wrap" Margin="0,2,0,0" Text="더 새로운 CyanDeck 스키마의 설정 파일은 자동으로 덮어쓰지 않습니다. 호환성 폴더에 보존해 새 버전에서 복구할 수 있도록 합니다."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="StartupSection" Text="자동 안전 모드" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="CrashLoopProtectionCheck" Content="비정상 시작이 반복되면 자동으로 안전 모드"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="다음 시작부터 적용됩니다. 정상 종료하면 기록이 지워집니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=CrashLoopProtectionCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="안전 모드로 바꿀 비정상 시작 횟수"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="CrashLoopThresholdText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="CrashLoopThresholdSlider" AutomationProperties.Name="안전 모드로 바꿀 비정상 시작 횟수" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CrashLoopThresholdSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="최근 몇 분 안의 시작만 세기"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="CrashLoopWindowText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="CrashLoopWindowSlider" AutomationProperties.Name="최근 몇 분 안의 시작만 세기" Minimum="2" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CrashLoopWindowSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource StatusBox}">
                                    <TextBlock x:Name="StartupHealthText" Foreground="#98A3B3" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="비정상 시작 기록 지우기" Margin="0" Click="ResetStartupHealth_Click"/>
                                        <TextBlock Style="{StaticResource RowCaption}" VerticalAlignment="Center" Margin="10,0,0,0" Text="즉시 실행"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="PolicySection" Text="관리 정책" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipBorder}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="관리자용"/>
                                </Border>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="대부분 바꿀 필요가 없습니다. 관리 정책은 로컬 또는 UNC JSON 파일에서 읽습니다. 원본이 일시적으로 손상되거나 없어져도 현재 적용 중인 정책은 자동으로 해제되지 않습니다."/>
                                <Border Style="{StaticResource StatusBox}">
                                    <TextBlock x:Name="ManagedPolicyStatusText" TextWrapping="Wrap" Foreground="#D6DCE5"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Button Content="관리 정책 다시 불러오기" HorizontalAlignment="Left" Margin="0" Click="ReloadManagedPolicy_Click"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="초기화 · 되돌리기 어려운 작업" FontSize="13" FontWeight="SemiBold" Foreground="#E39A9A" Margin="4,10,0,8"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="ResetSection" Text="설정 기본값 복원" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="모든 페이지의 설정을 기본값으로 바꿉니다. 그룹·아이콘·일정은 그대로이며 '저장'을 눌러야 적용됩니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="ResetGeneralButton" Content="모든 설정을 기본값으로 채우기" Margin="0" Click="ResetGeneral_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="저장해야 적용"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#5A3438" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="WindowResetSection" Text="창 위치·기본 그룹 복원" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="그룹과 아이콘은 그대로 두고 백업한 뒤 창 위치와 크기만 기본 배치로 되돌리고 다시 시작합니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="ResetAllWindowGeometryButton" Content="모든 그룹·캘린더 창 위치와 크기 초기화…" Style="{StaticResource DeckWarningButtonStyle}" Margin="0" Click="ResetAllWindowGeometry_Click"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="실행 후 다시 시작"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Separator Margin="0,6,0,12" Background="#344254"/>
                                <!-- Classic check boxes: they choose targets for the command below, not saved settings.
                                     Never wrapped, because the reset code reads their effective IsEnabled. -->
                                <StackPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="ResetGroupGeometryCheck" Style="{StaticResource DarkCheckBoxStyle}" Content="기본 그룹 구성 다시 만들기" IsChecked="True" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ResetCalendarGeometryCheck" Style="{StaticResource DarkCheckBoxStyle}" Content="캘린더 창 위치·크기 초기화" IsChecked="True" Margin="0,0,0,8"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,0,0,10" Text="삭제된 기본 그룹이나 빠진 아이콘까지 되돌리려면 위에서 고른 항목을 아래 버튼으로 복원하세요. 기본 그룹 구성 다시 만들기는 사용자 지정 그룹·탭·폴더 포털과 분류 규칙을 기본 구성으로 바꿉니다(실제 파일은 지우지 않음). 실행 전에 복구 백업을 남깁니다."/>
                                <Button x:Name="ResetPlacementButton" Content="선택한 항목 복원 후 다시 시작…" HorizontalAlignment="Left" Margin="0" Click="ResetPlacement_Click"
                                        Style="{StaticResource DeckDangerButtonStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#5A3438" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="FactoryResetSection" Text="전체 초기화" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="그룹·레이아웃과 CyanDeck 설정을 처음 상태로 되돌리고 다시 시작합니다. 먼저 원본 설정을 백업하며 실제 파일·폴더, 로컬 일정, Google 로그인과 캘린더 계정 데이터는 지우지 않습니다."/>
                                        <Button x:Name="FactoryResetButton" Grid.Column="2" Content="전체 프로그램 설정 및 그룹 초기화…" Margin="0" VerticalAlignment="Center" Click="FactoryReset_Click"
                                                Style="{StaticResource DeckDangerButtonStyle}"/>
                                    </Grid>
                                </Border>
                                <Separator Margin="0,6,0,12" Background="#344254"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowEffect}" Text="이 PC의 CyanDeck 설정·그룹·로컬 일정·Google 로그인 토큰·연결 정보·백업·스냅샷·로그를 삭제하고 첫 실행 설정부터 다시 시작합니다. Google 서버 일정, 바탕화면 원본 파일, 설치된 프로그램은 삭제하지 않습니다."/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E39A9A" TextWrapping="Wrap" Margin="0,4,0,0" Text="복구용 백업을 자동으로 만들지 않으므로 되돌릴 수 없습니다."/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,4,0,0" Text="로컬 일정은 캘린더 설정 → 일정 백업 → '로컬 일정 내보내기'로, 또는 '레이아웃 및 설정 내보내기'로 함께 백업할 수 있습니다."/>
                                        </StackPanel>
                                        <Button x:Name="CompleteLocalResetButton" Grid.Column="2" Content="모든 CyanDeck 사용자 데이터 완전 초기화…" Margin="0" VerticalAlignment="Center" Click="CompleteLocalReset_Click"
                                                Style="{StaticResource DeckDangerButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
            </Grid>
        </Grid>
        <!-- One save point for the whole window: settings changed on any page wait here until
             '저장'. Buttons inside the pages run their command right away (destructive ones are
             red); they never save pending edits without asking. -->
        <Border x:Name="SaveBar" Grid.Row="1" Margin="0,12,0,0" Padding="14,9" CornerRadius="8" BorderThickness="1"
                Background="#1A1E24" BorderBrush="#2C333D">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="저장" Click="Apply_Click" Style="{StaticResource DeckPrimaryButtonStyle}"
                            Padding="26,7" Margin="12,0,0,0" ToolTip="이 창에서 바꾼 설정을 저장하고 바로 적용합니다 (Ctrl+S)"/>
                    <Button x:Name="CloseButton" Content="닫기" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0"
                            ToolTip="창을 닫습니다. 저장하지 않은 변경 사항이 있으면 먼저 묻습니다."/>
                </StackPanel>
                <TextBlock x:Name="SaveStateText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#8F9AA8"
                           Text="이 창에서 바꾼 설정은 '저장'을 눌러야 적용됩니다."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

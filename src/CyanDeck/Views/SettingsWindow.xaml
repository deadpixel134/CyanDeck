<Window x:Class="CyanDeck.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyanDeck 설정" Width="1040" Height="760"
        MinWidth="940" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#15171B" Foreground="#F2F4F8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
                <ResourceDictionary Source="../Themes/ReadableComboBoxes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Let labels inherit Window.Foreground. An implicit TextBlock foreground
                 overrides ComboBoxItem.Foreground inside the native dropdown and
                 creates light-on-light unreadable entries. -->

            <!-- On/off settings stay CheckBoxes (save, signature and policy code depend on the type)
                 but look like Windows 11 switches: title on the left, state and track on the right.
                 Template parts are named once only. -->
            <Style x:Key="DeckSwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#EEF2F8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Foreground" Value="#EEF2F8"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="SwitchStateText" Text="끔" FontSize="12" Foreground="#AAB4C2"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Grid Width="38" Height="18" VerticalAlignment="Center">
                                        <Border x:Name="SwitchFocusRing" Margin="-3" CornerRadius="12" BorderBrush="#5D91D8"
                                                BorderThickness="2" Visibility="Collapsed"/>
                                        <Border x:Name="SwitchTrack" CornerRadius="9" BorderBrush="#7D8794" BorderThickness="1"
                                                Background="Transparent"/>
                                        <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="#C9D2DE"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="3"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchStateText" Property="Text" Value="켬"/>
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#3B78A8"/>
                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent"/>
                                    <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF"/>
                                    <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="23"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#9AA5B3"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#4A88BA"/>
                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent"/>
                                </MultiTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="SwitchFocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DeckSwitchStyle}"/>
            <Style TargetType="Label"><Setter Property="Foreground" Value="#AEB8C6"/></Style>
            <!-- Keep the native WPF ComboBox/Popup template to preserve mouse capture.
                 Only the item containers use a deterministic accessible palette. -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource ReadableComboBoxStyle}">
                <Setter Property="Margin" Value="0,4,0,10"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Width" Value="240"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource DarkSliderStyle}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}"><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
            <!-- Restarts and confirmed replacements: amber outline between the plain and the danger role. -->
            <Style x:Key="DeckWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#2A2519"/>
                <Setter Property="Foreground" Value="#F2D9A6"/>
                <Setter Property="BorderBrush" Value="#C9A15A"/>
                <!-- Style triggers outrank the base template's hover/press triggers, which would
                     otherwise replace the amber colours with the plain button's grey. -->
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsEnabled" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="#3A3220"/>
                        <Setter Property="BorderBrush" Value="#E0B870"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsPressed" Value="True"/>
                            <Condition Property="IsEnabled" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="#453B25"/>
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="#3A3428"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Page and card typography. -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F4F7FD"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="PageDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#AAB9C9"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,18"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#E9F1FC"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
            <Style x:Key="SectionDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#98A3B3"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="SubsectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#C9D3E0"/>
                <Setter Property="Margin" Value="0,12,0,2"/>
            </Style>
            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#EEF2F8"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="RowDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#98A3B3"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,60,0"/>
            </Style>
            <Style x:Key="RowEffect" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#C9D3E0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="RowNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#8FB3D9"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RowCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#7F8A99"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#AAB4C2"/>
            </Style>

            <!-- Rows, status boxes and chips. CornerRadius 10 is reserved for section cards
                 (ScrollSectionToTop finds the card by it), so every inner element uses less. -->
            <Style x:Key="SettingRow" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="BorderBrush" Value="#2E3540"/>
                <Setter Property="Padding" Value="0,10"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style x:Key="StatusBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#20242B"/>
                <Setter Property="BorderBrush" Value="#3A424E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="#2B3340"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <!-- The '고급' label lives in the template, outside the logical tree, so search never indexes it. -->
            <Style x:Key="AdvancedDividerStyle" TargetType="Separator">
                <Setter Property="Margin" Value="0,12,0,2"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="고급" FontSize="11" Foreground="#7D8794" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="#2E3540" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- Category navigation replaces the crowded horizontal tabs. The original
             settings editors remain intact; tree leaves scroll to named sections. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1D222B" BorderBrush="#343A44" BorderThickness="1" CornerRadius="8" Padding="8,10">
                <DockPanel>
                    <!-- Search sits at the top of the sidebar, outside SettingsTabs, so typing never marks the window dirty. -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBox x:Name="SettingsSearchBox" Height="32" Padding="9,4" TextChanged="SettingsSearchBox_TextChanged" KeyDown="SettingsSearchBox_KeyDown" AutomationProperties.Name="설정 검색"
                                     ToolTip="설정 이름이나 설명의 낱말로 찾습니다. Enter: 다음 결과 · Esc: 검색 지우기"/>
                            <TextBlock Text="설정 검색" Margin="11,0,0,0" Foreground="#778391" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="SettingsSearchHint" FontSize="11.5" Foreground="#98A3B3" Margin="2,4,0,8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TreeView x:Name="SettingsNavigation" Background="Transparent" Foreground="#EAF0F8"
                              BorderThickness="0" SelectedItemChanged="SettingsNavigation_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="설정 분류 트리">
                        <TreeView.Resources>
                            <!-- Accordion: only the selected category is open (code sets IsExpanded);
                                 a search query opens every category with a match. -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#C9D3E0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Margin" Value="18,1,0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="NavItemChrome" Grid.Row="0" Background="Transparent" CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center">
                                                        <ContentPresenter.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                            </Style>
                                                        </ContentPresenter.Resources>
                                                    </ContentPresenter>
                                                </Border>
                                                <Border x:Name="NavSelectionBar" Grid.Row="0" Width="3" Height="16" CornerRadius="1.5"
                                                        Background="#5D91D8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="Collapsed"/>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger SourceName="NavItemChrome" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NavItemChrome" Property="Background" Value="#232A35"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="NavItemChrome" Property="Background" Value="#2A3240"/>
                                                    <Setter TargetName="NavSelectionBar" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#EAF0F8"/>
                                        <Setter Property="Padding" Value="8,7"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                        <TreeViewItem x:Name="NavGeneral" Header="시작·새 항목 정리" Tag="GeneralTab|FeaturesSection">
                            <TreeViewItem Header="시작·기능 사용" Tag="GeneralTab|FeaturesSection"/>
                            <TreeViewItem Header="새 바탕화면 항목 정리" Tag="GeneralTab|DesktopSection"/>
                            <TreeViewItem Header="자동 분류 규칙" Tag="GeneralTab|RulesSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="그룹 모양" Tag="AppearanceTab|ChameleonSection">
                            <TreeViewItem Header="흐리게 (카멜레온)" Tag="AppearanceTab|ChameleonSection"/>
                            <TreeViewItem Header="제목 표시줄 버튼" Tag="AppearanceTab|GroupChromeSection"/>
                            <TreeViewItem Header="배경 흐림·스크롤바" Tag="AppearanceTab|GroupSurfaceSection"/>
                            <TreeViewItem Header="아이콘 이동 효과" Tag="AppearanceTab|ItemAnimationSection"/>
                            <TreeViewItem Header="그룹 개별 편집" Tag="GroupsTab|GroupEditorSection"/>
                            <TreeViewItem Header="그룹별 아이콘" Tag="GroupsTab|GroupIconsSection"/>
                            <TreeViewItem Header="그룹별 배경" Tag="GroupsTab|GroupBackgroundSection"/>
                            <TreeViewItem Header="그룹별 제목 표시줄" Tag="GroupsTab|GroupTitleSection"/>
                            <TreeViewItem Header="그룹별 접기·잠금" Tag="GroupsTab|GroupBehaviorSection"/>
                            <TreeViewItem Header="모든 그룹 공통 간격" Tag="GroupsTab|LinkedSpacingSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="바탕화면 아이콘·휴지통" Tag="SystemIconsTab|StandaloneSection">
                            <TreeViewItem Header="그룹 밖 아이콘" Tag="SystemIconsTab|StandaloneSection"/>
                            <TreeViewItem Header="휴지통" Tag="SystemIconsTab|RecycleSection"/>
                            <TreeViewItem Header="미리보기·바로 가기 화살표" Tag="SystemIconsTab|DesktopIconStyleSection"/>
                            <TreeViewItem Header="Windows 기본 아이콘 그룹" Tag="SystemIconsTab|SystemGroupSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="그룹 동작" Tag="InteractionTab|CreateGroupSection">
                            <TreeViewItem Header="그룹 만들기" Tag="InteractionTab|CreateGroupSection"/>
                            <TreeViewItem Header="끌기·맞춤" Tag="InteractionTab|SnapSection"/>
                            <TreeViewItem Header="탭으로 합치기·전환" Tag="InteractionTab|TabsSection"/>
                            <TreeViewItem Header="그룹 접기" Tag="InteractionTab|RollupSection"/>
                            <TreeViewItem Header="폴더 포털" Tag="InteractionTab|FolderPortalSection"/>
                            <TreeViewItem Header="대량 작업 확인" Tag="InteractionTab|BatchConfirmSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="바탕화면 페이지" Tag="AnimationTab|GesturesSection">
                            <TreeViewItem Header="페이지 넘기기 제스처" Tag="AnimationTab|GesturesSection"/>
                            <TreeViewItem Header="페이지 전환 효과" Tag="AnimationTab|PageAnimationSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Peek·빠른 숨김" Tag="PeekTab|QuickHideSection">
                            <TreeViewItem Header="빠른 숨김" Tag="PeekTab|QuickHideSection"/>
                            <TreeViewItem Header="Peek (창 위로 보기)" Tag="PeekTab|PeekSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="캘린더" Tag="CalendarTab|CalendarSection">
                            <TreeViewItem Header="사용·보기 방식·크기" Tag="CalendarTab|CalendarSection"/>
                            <TreeViewItem Header="글자·배경색" Tag="CalendarTab|CalendarAppearanceSection"/>
                            <TreeViewItem Header="캘린더 흐리게" Tag="CalendarTab|CalendarFadeSection"/>
                            <TreeViewItem Header="Google 개발용 ID" Tag="CalendarTab|GoogleSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="모니터·백업" Tag="LayoutTab|MonitorLayoutSection">
                            <TreeViewItem Header="모니터가 바뀔 때" Tag="LayoutTab|MonitorLayoutSection"/>
                            <TreeViewItem Header="레이아웃 스냅샷" Tag="LayoutTab|SnapshotsSection"/>
                            <TreeViewItem Header="백업·복원" Tag="LayoutTab|BackupSection"/>
                            <TreeViewItem Header="복구 지점" Tag="LayoutTab|RecoveryPointsSection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="성능" Tag="PerformanceTab|LoadingPerformanceSection">
                            <TreeViewItem Header="불러오기·캐시" Tag="PerformanceTab|LoadingPerformanceSection"/>
                            <TreeViewItem Header="저장 대기 시간" Tag="PerformanceTab|PerformanceSection"/>
                        </TreeViewItem>
                        <!-- The always-available pages: no managed policy can lock them. -->
                        <TreeViewItem Header="업데이트·정보" Tag="UpdatesTab|AboutSection" Margin="0,14,0,0">
                            <TreeViewItem Header="버전·업데이트 확인" Tag="UpdatesTab|AboutSection"/>
                            <TreeViewItem Header="자동 업데이트" Tag="UpdatesTab|UpdatesSection"/>
                            <TreeViewItem Header="업데이트 경로 (관리자용)" Tag="UpdatesTab|UpdateSourceSection"/>
                            <TreeViewItem Header="업데이트 문제 해결" Tag="UpdatesTab|UpdateRecoverySection"/>
                        </TreeViewItem>
                        <TreeViewItem Header="문제 해결·초기화" Tag="AboutTab|TroubleshootSection">
                            <TreeViewItem Header="진단·복구 도구" Tag="AboutTab|TroubleshootSection"/>
                            <TreeViewItem Header="안전 모드·다시 시작" Tag="AboutTab|RestartSection"/>
                            <TreeViewItem Header="자동 안전 모드" Tag="AboutTab|StartupSection"/>
                            <TreeViewItem Header="관리 정책" Tag="AboutTab|PolicySection"/>
                            <TreeViewItem Header="설정 기본값 복원" Tag="AboutTab|ResetSection"/>
                            <TreeViewItem Header="창 위치·기본 그룹 복원" Tag="AboutTab|WindowResetSection"/>
                            <TreeViewItem Header="전체 초기화" Tag="AboutTab|FactoryResetSection"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <!-- Window-wide state (compatibility protection, safe mode, managed policy). It sits outside
                     SettingsTabs and every page ScrollViewer, so the unsaved-change signature never sees it. -->
                <Border x:Name="StateBanner" Grid.Row="0" CornerRadius="8" Background="#2B2618" BorderBrush="#5A4A26" BorderThickness="1"
                        Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="StateBannerLink" DockPanel.Dock="Right" Content="자세히 →" Style="{StaticResource DeckLinkButtonStyle}"
                                Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock x:Name="StateBannerText" Foreground="#F2D9A6" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="#1B1E24" BorderBrush="#343A44">
                <!-- Retain TabItems as edit views, but remove the competing top navigation. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

            <!-- ============================== 시작·새 항목 정리 ============================== -->
            <TabItem x:Name="GeneralTab" Header="시작·새 항목 정리">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="시작·새 항목 정리" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="CyanDeck 기능을 켜고 끄며, Windows 시작 시 실행과 새 바탕화면 항목을 자동으로 정리하는 방법을 정합니다." Style="{StaticResource PageDescription}"/>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="FeaturesSection" Text="시작·기능 사용" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="DeckModuleCheck" Content="그룹·아이콘 관리 사용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Foreground="#E3B86A" Text="끄면 캘린더만 실행됩니다. 바꾼 뒤 저장하면 CyanDeck이 자동으로 다시 시작됩니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 CyanDeck 실행"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <WrapPanel>
                                        <Button Content="캘린더 켜기·끄기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="CalendarTab|CalendarSection" Click="SettingsLink_Click" Margin="0,0,12,0"/>
                                        <Button Content="Windows 아이콘 숨기기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="SystemIconsTab|StandaloneSection" Click="SettingsLink_Click"/>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="DesktopSection" Text="새 바탕화면 항목 정리" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="바탕화면에 새로 생긴 항목을 어디에 둘지 정합니다. 실제 파일은 옮기거나 복사하지 않습니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoImportCheck" Content="새 바탕화면 항목 자동 정리"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="새로 생긴 파일과 바로 가기를 규칙과 아래 기본 위치에 따라 그룹에 넣거나 바탕화면에 둡니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AutoImportCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="규칙에 맞지 않는 새 항목을 둘 곳"/>
                                            <ComboBox x:Name="DefaultDesktopPlacementCombo" Width="360" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="DefaultDesktopPlacementCombo_SelectionChanged" AutomationProperties.Name="규칙에 맞지 않는 새 항목을 둘 곳"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,6,0,0" Text="자동 분류 (규칙·파일 종류) · 그룹 밖 바탕화면('Windows 아이콘 숨기고 CyanDeck으로 표시'가 켜져 있을 때만 보임) · 특정 그룹 / 탭. 폴더 포털은 고를 수 없습니다."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <CheckBox x:Name="ActivateDefaultDestinationTabCheck" Content="보낸 탭을 맨 앞에 표시"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="새 항목이 위에서 고른 그룹 / 탭에 들어가면 그 탭을 선택합니다. 규칙으로 보낸 항목에는 적용되지 않습니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="TrackDesktopLocationCheck" Content="바탕화면 폴더가 옮겨지면 따라가기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="OneDrive나 폴더 설정으로 바탕화면 폴더 위치가 바뀌면 새 위치를 자동으로 다시 연결합니다."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="RulesSection" Text="자동 분류 규칙" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="규칙은 그룹 탭 오른쪽 클릭 > 자동 분류 규칙에서 만들고 바꿉니다."/>
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=AutoImportCheck}">
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <StackPanel>
                                            <CheckBox x:Name="KeepRulesUpdatedCheck" Content="이미 정리된 항목에도 규칙 계속 적용"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="자동 정리할 때마다 기존 항목도 규칙에 맞는 탭으로 다시 옮깁니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="바탕화면에 고정한 항목을 뺀 모든 항목을 규칙과 파일 종류로 지금 다시 정리합니다. 그룹 밖에 둔 항목도 규칙에 맞으면 그룹으로 옮겨지고, 직접 옮겨 둔 아이콘도 다시 분류됩니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="자동 분류 규칙 지금 실행" Margin="0" Click="ApplyRulesNow_Click"
                                                    ToolTip="저장된 자동 분류 규칙으로 바탕화면 항목을 지금 정리합니다. 직접 옮겨 둔 아이콘도 다시 규칙에 따라 분류됩니다."/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Legacy mirror of the placement choice: tracked by the signature, never shown or searched. -->
                        <CheckBox x:Name="LeaveNewDesktopItemsCheck" Content="새로 생긴 바탕화면 항목은 그룹 밖 바탕화면 아이콘으로 유지" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 그룹 모양 ============================== -->
            <TabItem x:Name="AppearanceTab" Header="그룹 모양">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="그룹 모양" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="모든 그룹에 함께 적용되는 흐리게, 제목 표시줄 버튼, 배경 흐림과 아이콘 이동 효과입니다. 그룹 하나만 바꾸려면 아래 '그룹 개별 편집'을 쓰세요." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="켜기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GeneralTab|FeaturesSection" Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="ChameleonSection" Text="흐리게 (카멜레온)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="마우스가 멀어지면 그룹을 흐리게 합니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ChameleonCheck" Content="마우스가 멀어지면 그룹 흐리게"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="그룹마다 끄려면 그룹 오른쪽 클릭 메뉴의 '마우스가 멀어지면 흐리게'를 해제하세요."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ChameleonCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="흐릴 때 불투명도"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="IdleOpacityText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="IdleOpacitySlider" AutomationProperties.Name="흐릴 때 불투명도" Minimum="0.15" Maximum="1" TickFrequency="0.05" ValueChanged="IdleOpacitySlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="ChameleonFullColorHoverCheck" Content="마우스를 올리면 선명하게"/>
                                    </Border>
                                    <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChameleonDesktopUseCheck" Content="바탕화면이나 CyanDeck 창을 쓰는 동안 선명하게"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="이 설정 창이 열려 있는 동안에도 그룹이 선명하게 보입니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="GroupChromeSection" Text="제목 표시줄 버튼" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ShowHeaderControlsCheck" Content="제목 표시줄에 검색·접기·메뉴 버튼 표시"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="끄면 오른쪽 클릭 메뉴와 두 번 클릭으로만 접을 수 있습니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ShowHeaderControlsCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="ShowTitlebarControlsHoverCheck" Content="마우스를 올렸을 때만 버튼 표시"/>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="ShowInactiveTabControlsCheck" Content="선택되지 않은 탭에도 메뉴·닫기 버튼 표시"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="GroupSurfaceSection" Text="배경 흐림·스크롤바" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="BlurWallpaperCheck" Content="그룹 뒤 배경화면 흐림(블러)"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="그룹 배경이 투명할수록 잘 보입니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="HideInactiveScrollbarsCheck" Content="마우스가 그룹 밖에 있으면 스크롤바 숨기기"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="ItemAnimationSection" Text="아이콘 이동 효과" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="Windows 애니메이션 효과가 꺼져 있으면 동작하지 않습니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AnimateIconsWhenMovedCheck" Content="아이콘이 자리를 옮길 때 미끄러지듯 이동"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="정렬·추가·삭제·크기 조절 뒤 위치가 바뀐 아이콘만 움직입니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AnimateIconsWhenMovedCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="이동 시간"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="IconMovementDurationText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="IconMovementDurationSlider" AutomationProperties.Name="이동 시간" Minimum="80" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="IconMovementDurationSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="이보다 많이 움직이면 애니메이션 생략"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="IconMovementMaxItemsText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="IconMovementMaxItemsSlider" AutomationProperties.Name="이보다 많이 움직이면 애니메이션 생략" Minimum="8" Maximum="256" TickFrequency="8" IsSnapToTickEnabled="True" ValueChanged="IconMovementMaxItemsSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="AnimateItemChangesCheck" Content="내용이 바뀌면 목록을 살짝 페이드"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 그룹 개별 편집 ==============================
                 This is an Appearance subpage, not a competing sidebar root.
                 Keep the complete per-group editor isolated so the common
                 Appearance page remains compact and group draft/permission
                 boundaries retain their original owning TabItem. -->
            <TabItem x:Name="GroupsTab" Header="그룹 개별 편집">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="그룹 개별 편집" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="그룹을 선택한 뒤 그 그룹의 아이콘, 배경, 제목 표시줄, 접기·잠금을 바꿉니다. 모든 그룹 공통 설정은 '그룹 모양'의 다른 항목에 있습니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="켜기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GeneralTab|FeaturesSection" Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <!-- Group picker, presets and reset stay outside GroupEditor: GroupEditor is disabled
                             until a group is chosen, and FencePicker is excluded from the signature. -->
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="GroupEditorSection" Text="그룹 개별 편집" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="편집할 그룹을 고르면 아래 네 카드의 값이 그 그룹에만 적용됩니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="편집할 그룹"/>
                                        <ComboBox x:Name="FencePicker" Width="360" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="편집할 그룹" SelectionChanged="FencePicker_SelectionChanged"/>
                                        <TextBlock Text="아직 그룹이 없습니다. 바탕화면에서 사각형을 그려 그룹을 만드세요." Foreground="#E3B86A" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=FencePicker}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="크기 프리셋"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="아이콘 크기·간격·제목 글자 크기를 한 번에 바꿉니다"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="좁게" Margin="0,0,8,0" Click="CompactPreset_Click"/>
                                            <Button Content="균형" Margin="0,0,8,0" Click="BalancedPreset_Click"/>
                                            <Button Content="크게" Margin="0" Click="LargePreset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="아이콘·배경·제목·접기·잠금을 기본값으로 되돌립니다(잠금도 풀립니다). 모서리·색조·탭 모양은 그룹 메뉴에서 바꿉니다."/>
                                        <Button Grid.Column="2" Content="이 그룹 설정 초기화" Margin="0" VerticalAlignment="Center" Click="ResetSelectedGroup_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Every per-group draft control stays a logical descendant of GroupEditor. -->
                        <StackPanel x:Name="GroupEditor">
                            <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="GroupIconsSection" Text="그룹별 아이콘" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <Grid>

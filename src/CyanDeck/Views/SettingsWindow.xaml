                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="그룹 배치와 CyanDeck 설정을 파일로 저장합니다. 임시 파일에 먼저 쓰고 다시 읽어 확인한 뒤 기존 파일과 바꿉니다."/>
                                        <Button Grid.Column="2" Content="레이아웃 및 설정 내보내기…" Margin="0" VerticalAlignment="Center" Click="Export_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="현재 그룹과 설정을 파일 내용으로 바꾸고 이 창을 닫습니다. 바뀌는 내용을 먼저 보여 주고, 실행 전에 복구 지점을 저장하며, 현재 스냅샷은 지우지 않고 함께 보관합니다."/>
                                        <Button x:Name="ImportConfigurationButton" Grid.Column="2" Content="레이아웃 및 설정 가져오기…" Style="{StaticResource DeckWarningButtonStyle}" Margin="0" VerticalAlignment="Center" Click="Import_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="Google에 올리지 않은 로컬 캘린더 일정은 백업 파일 옆에 .calendar-events.json 파일로 함께 저장되며, 캘린더 설정의 '일정 가져오기…'로 되살립니다. Google 캘린더 일정(Google에 보관됨)과 Google 로그인 정보는 백업에 들어 있지 않습니다."/>
                                <Border CornerRadius="8" Background="#261E21" BorderBrush="#5A3438" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="되돌리기 어려운 작업" FontSize="13" FontWeight="SemiBold" Foreground="#E39A9A"/>
                                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="모든 그룹을 지우고 앱·작업·미디어 기본 그룹을 새로 만든 뒤 바탕화면 항목을 다시 정리합니다. 먼저 복구 지점을 만듭니다."/>
                                                <Button x:Name="AutomaticLayoutButton" Grid.Column="2" Content="기본 그룹 구성으로 다시 만들기…" Margin="0" VerticalAlignment="Center" Click="AutomaticLayout_Click"
                                                        Style="{StaticResource DeckDangerButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- v8.0.44: every recovery checkpoint, newest first. Rows are built in code
                             (RefreshRecoveryPointList); restoring replaces the whole state and closes this window. -->
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="RecoveryPointsSection" Text="복구 지점" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="업데이트·가져오기·초기화·삭제·비정상 종료 전과 모니터가 바뀔 때 CyanDeck이 자동으로 저장한 상태입니다. 중요 작업 전 복구 지점은 최근 20개 또는 30일치, 모니터 변경 자동 복구 지점은 최근 5개, 기타 복구 지점은 최근 12개를 보관합니다. 복원하면 바뀌는 내용을 먼저 보여 주고, 지금 상태도 복구 지점으로 남깁니다."/>
                                <Border Style="{StaticResource StatusBox}">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="RecoveryPointList"/>
                                    </ScrollViewer>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <WrapPanel>
                                        <Button Content="복구 폴더 열기" Margin="0,0,8,4" Click="OpenRecoveryFolder_Click"/>
                                        <Button Content="목록 새로 고침" Margin="0,0,8,4" Click="RefreshRecoveryPoints_Click"/>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 성능 ============================== -->
            <TabItem x:Name="PerformanceTab" Header="성능">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="성능" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="항목이 아주 많아 느리거나 메모리를 많이 쓸 때만 바꾸세요. 대부분 그대로 두면 됩니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">

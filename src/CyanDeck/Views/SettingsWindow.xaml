                                        <TextBlock Style="{StaticResource RowDescription}" Text="그룹 메뉴의 '다른 페이지로 보내기'에 적용됩니다. 끄면 보낸 그룹만 사라지고 지금 페이지에 머뭅니다. 지금 페이지가 비게 되면 항상 따라갑니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="TouchPageGesturesCheck" Content="두 손가락으로 밀어 페이지 넘기기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="터치스크린의 빈 바탕화면에서 좌우로 밉니다. '바탕화면 아이콘·휴지통 > Windows 아이콘 숨기고 CyanDeck으로 표시'가 켜져 있어야 합니다."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=HideNativeIconsCheck}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource RowNote}" Text="참고: 지금은 Windows 아이콘 숨기기가 꺼져 있어 동작하지 않습니다"/>
                                            <Button Content="Windows 아이콘 숨기기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="SystemIconsTab|StandaloneSection" Click="SettingsLink_Click" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="PageKeyboardCommandsCheck" Content="단축키용 바로 가기로 페이지 이동 허용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="'CyanDeck 다음 페이지 / 이전 페이지' 바로 가기(--page-next, --page-previous)에 쓰입니다. CyanDeck은 키 입력을 감시하지 않으며, 바로 가기 키는 바로 가기 속성에서 지정합니다."/>
                                        <Button Content="단축키용 바로 가기 만들기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="PeekTab|PeekSection" Click="SettingsLink_Click" HorizontalAlignment="Left" Margin="-5,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Separator Style="{StaticResource AdvancedDividerStyle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="PageBothButtonsDragCheck" Content="왼쪽+오른쪽 버튼으로 끌어 페이지 넘기기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="두 버튼을 함께 누르면 빈 바탕화면 그룹 만들기는 취소됩니다."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="PageAnimationSection" Text="페이지 전환 효과" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AnimatePagesCheck" Content="페이지 전환 애니메이션 사용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="Windows 애니메이션 효과가 꺼져 있으면 적용되지 않습니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=AnimatePagesCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="전환 시간"/>

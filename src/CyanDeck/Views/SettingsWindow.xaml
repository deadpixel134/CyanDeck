                                    <StackPanel>
                                        <CheckBox x:Name="QuickHideCheck" Content="빠른 숨김 사용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="실행 방법: 트레이 메뉴의 '빠른 숨김', 빈 바탕화면 또는 트레이 아이콘 더블클릭, 단축키용 바로 가기. 숨김 중에는 트레이 아이콘이 흐리게 표시됩니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=QuickHideCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <CheckBox x:Name="DesktopDoubleClickQuickHideCheck" Content="빈 바탕화면 더블클릭으로 빠른 숨김"/>

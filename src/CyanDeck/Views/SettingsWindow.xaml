                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="트레이 아이콘 더블클릭"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="안전 모드와 캘린더 전용 모드에서는 항상 설정을 엽니다. '빠른 숨김 켜기/끄기'는 위의 '빠른 숨김 사용'이 켜져 있을 때만 작동합니다. '동작 없음'이어도 숨김 중이면 다시 표시합니다."/>
                                        </StackPanel>
                                        <ComboBox x:Name="TrayDoubleClickActionCombo" Grid.Column="2" Style="{StaticResource RowCombo}" Width="280" AutomationProperties.Name="트레이 아이콘 더블클릭"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel Orientation="Horizontal">

                                <TextBlock Text="투명도"/>
                                <DockPanel><TextBlock x:Name="BackgroundTransparencyText" DockPanel.Dock="Right"/><Slider x:Name="BackgroundTransparencySlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BackgroundAdjustment_ValueChanged"/></DockPanel>

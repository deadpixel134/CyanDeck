                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="UpdateSourceSection" Text="업데이트 경로 (관리자용)" Style="{StaticResource SectionTitle}"/>

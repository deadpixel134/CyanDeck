                                            <!-- Content follows UpdateRollbackHold.DescribeRollbackCommand (rollback or undo), like the tray item. -->
                                            <Button x:Name="RollbackUpdateButton" Content="마지막 앱 업데이트 되돌리기…" Margin="0" Click="RollbackUpdate_Click"
                                                    Style="{StaticResource DeckDangerButtonStyle}"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="실행 후 다시 시작"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="RollbackHoldPanel" Style="{StaticResource SettingRow}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="RollbackHoldText" Style="{StaticResource RowNote}"/>

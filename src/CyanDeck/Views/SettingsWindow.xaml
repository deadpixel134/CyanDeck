                                                            <Slider x:Name="StandaloneIconHoverOpacitySlider" AutomationProperties.Name="마우스를 올렸을 때 불투명도" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StandaloneIconOpacitySlider_ValueChanged"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingRow}">
                                                    <StackPanel>
                                                        <CheckBox x:Name="StandaloneIconIncludeRecycleCheck" Content="휴지통에도 적용"/>
                                                        <TextBlock Style="{StaticResource RowDescription}" Text="끄면 휴지통은 '그룹 모양 > 흐리게 (카멜레온)' 설정을 따릅니다."/>
                                                        <Button Content="그룹 흐리게 설정 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="AppearanceTab|ChameleonSection" Click="SettingsLink_Click" HorizontalAlignment="Left" Margin="-5,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <CheckBox x:Name="TouchIconFlickCheck" Content="터치로 튕겨 아이콘을 그룹에 넣기"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="그룹 밖 아이콘을 그룹 쪽으로 빠르게 튕기면 그 그룹의 현재 탭으로 들어갑니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="RecycleSection" Text="휴지통" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="StandaloneRecycleCheck" Content="바탕화면에 휴지통 표시"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="CyanDeck이 그룹 밖에 휴지통을 직접 표시합니다. 빠른 숨김으로도 숨겨지지 않습니다."/>
                                        <TextBlock Margin="0,6,0,0" Text="참고: 위의 Windows 아이콘 숨기기가 켜져 있을 때만 보입니다">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowNote}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=HideNativeIconsCheck}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=StandaloneRecycleCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="휴지통을 주 모니터 오른쪽 아래로 옮깁니다."/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button x:Name="ResetStandaloneRecycleButton" Content="휴지통 위치 초기화" Click="ResetStandaloneRecycleBin_Click" Margin="0"/>
                                                <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="DesktopIconStyleSection" Text="미리보기·바로 가기 화살표" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="그룹 안과 밖의 모든 아이콘에 적용됩니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ShowFilePreviewsCheck" Content="파일 미리보기(썸네일) 표시"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="이미지·PDF·문서는 프로그램 아이콘 대신 내용을 보여 줍니다. 켜면 목록은 항상 백그라운드에서 불러옵니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="HideFileShortcutBadgesCheck" Content="바로 가기(.lnk) 화살표 숨기기"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="HideInternetShortcutBadgesCheck" Content="인터넷 바로 가기(.url) 화살표 숨기기"/>
                                </Border>
                                <!-- Indented as a scope extension of the two switches above, but never disabled by them. -->
                                <StackPanel Margin="28,0,0,0">
                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <CheckBox x:Name="ShowShortcutBadgesInFolderPortalsCheck" Content="폴더 포털 안에도 위 화살표 설정 적용"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Text="끄면 폴더 포털은 Windows 탐색기와 같은 화살표를 씁니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="SystemGroupSection" Text="Windows 기본 아이콘 그룹" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="GroupRecycleCheck" Content="기본 아이콘 그룹에 휴지통 포함"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="이미 있는 기본 아이콘 그룹과 새로 추가하는 그룹에 적용됩니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowEffect}" VerticalAlignment="Center" Text="내 PC, 사용자 폴더, 네트워크, 제어판, 휴지통을 한 그룹에 담습니다. 이미 있으면 아무것도 하지 않습니다."/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="AddSystemIconGroupButton" Content="Windows 기본 아이콘 그룹 추가" Click="AddSystemIconGroup_Click" Margin="0"/>
                                            <TextBlock Style="{StaticResource RowCaption}" Text="즉시 실행"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 그룹 동작 ============================== -->
            <TabItem x:Name="InteractionTab" Header="그룹 동작">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="그룹 동작" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="그룹을 만들고, 끌어 맞추고, 탭으로 합치고, 접는 방식과 폴더 포털 동작을 정합니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="켜기 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GeneralTab|FeaturesSection" Click="SettingsLink_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="그룹·아이콘 관리가 꺼져 있어 이 페이지 설정은 저장만 되고 적용되지 않습니다." Foreground="#E3C88A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="CreateGroupSection" Text="그룹 만들기" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="빈 바탕화면에서 사각형을 그리고 놓으면 '여기에 새 그룹 만들기 / 폴더 포털 만들기…' 메뉴가 열립니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="사각형을 그릴 마우스 버튼"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="짧게 클릭하면 평소처럼 동작합니다. 왼쪽 버튼을 고르면 Windows 아이콘 범위 선택 대신 동작합니다."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CreateGroupMouseButtonCombo" Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="사각형을 그릴 마우스 버튼"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="Alt·Ctrl·Shift·Win을 누른 상태, 두 버튼을 함께 누른 경우, Peek·빠른 숨김·바탕화면 보기·안전 모드 중이나 관리 정책으로 막힌 경우에는 동작하지 않습니다."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="SnapSection" Text="끌기·맞춤" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="그룹과 아이콘을 끌어 옮기거나 그룹 크기를 바꿀 때의 동작입니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="SmartSnapCheck" Content="다른 그룹과 화면 가장자리에 맞추기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="꺼도 놓을 때 화면 가장자리에는 맞춰집니다."/>
                                    </StackPanel>
                                </Border>
                                <!-- Not wrapped: the gap also drives the auto-layout and recovery commands. -->
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="그룹 사이 간격"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="맞추기와 자동 정렬·복구 명령이 지키는 간격입니다."/>
                                        </StackPanel>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock x:Name="SnapGapText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <Slider x:Name="SnapGapSlider" AutomationProperties.Name="그룹 사이 간격" Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SnapGapSlider_ValueChanged"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SnapGroupSizeCheck" Content="크기를 바꾸면 아이콘 칸 단위로 맞추기"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="ProtectMultiSelectionCheck" Content="여러 아이콘을 선택한 채 끌기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="선택된 아이콘 중 하나를 눌러 끌 때 선택이 하나로 줄지 않습니다."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TabsSection" Text="탭으로 합치기·전환" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="EnableTabGroupsCheck" Content="그룹을 다른 그룹 위에 놓아 탭으로 합치기"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="끌어 온 그룹의 가운데가 다른 그룹 안에 들어가면 합쳐집니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=EnableTabGroupsCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="ConfirmTabGroupMergeCheck" Content="합치기 전에 묻기"/>
                                    </Border>
                                </StackPanel>
                                <!-- Applies to every group with several tabs, so it is not under the merge switch. -->
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="탭 전환 방식"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="기본값은 클릭 전환입니다. 마우스를 올리기만 해서는 탭이 바뀌지 않습니다. 자동 전환은 두 번째 옵션을 직접 선택할 때만 적용되며, 탭 드래그 중에는 작동하지 않습니다."/>
                                        </StackPanel>
                                        <ComboBox x:Name="TabSwitchModeCombo" Grid.Column="2" Style="{StaticResource RowCombo}" SelectedIndex="0" AutomationProperties.Name="탭 전환 방식">
                                            <ComboBoxItem Content="클릭하여 전환 (기본값)"/>
                                            <ComboBoxItem Content="마우스를 올리면 자동 전환"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="RollupSection" Text="그룹 접기" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Margin="0" Text="접힌 그룹을 여는 방식은 그룹마다 정합니다."/>
                                <Button Content="그룹별 접기·잠금 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="GroupsTab|GroupBehaviorSection" Click="SettingsLink_Click" HorizontalAlignment="Left" Margin="-5,2,0,6"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="EnableRollupCheck" Content="그룹 접기 사용"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="끄고 저장하면 접힌 그룹이 모두 펼쳐지고 가장자리 고정도 풀립니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=EnableRollupCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="RollupDoubleClickCheck" Content="제목 표시줄을 두 번 클릭해 접기·펼치기"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="RollupEdgeDockCheck" Content="화면 위·아래 끝에 놓으면 자동으로 접기"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="FolderPortalSection" Text="폴더 포털" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="실제 폴더를 보여 주는 폴더 포털 탭에만 적용됩니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="뒤로·앞으로 기록 개수"/>
                                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,0" Text="폴더 포털 탭마다 기억할 이동 기록 수입니다."/>
                                        </StackPanel>
                                        <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                            <TextBlock x:Name="PortalHistoryText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <Slider x:Name="PortalHistorySlider" AutomationProperties.Name="뒤로·앞으로 기록 개수" Minimum="5" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PortalHistorySlider_ValueChanged"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowNote}" Text="많은 파일을 휴지통으로 보낼 때의 확인은 '대량 작업 확인'에 있습니다"/>
                                        <Button Content="대량 작업 확인 →" Style="{StaticResource DeckLinkButtonStyle}" Tag="InteractionTab|BatchConfirmSection" Click="SettingsLink_Click" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- v8.0.44: the large-batch confirmation now also covers opening many group items at once,
                             so it has its own card instead of living under folder portals. -->
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="BatchConfirmSection" Text="대량 작업 확인" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionDescription}" Text="그룹이나 폴더 포털에서 많은 항목을 한 번에 다룰 때 적용됩니다."/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ConfirmLargeBatchCheck" Content="많은 항목을 열거나 휴지통으로 보낼 때 확인"/>
                                        <TextBlock Style="{StaticResource RowDescription}" Text="켜면 아래 기준 개수 이상을 한 번에 열거나 폴더 포털에서 휴지통으로 보낼 때 먼저 묻습니다. 끄면 여러 항목 열기는 처음 12개까지만 엽니다."/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ConfirmLargeBatchCheck}">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Text="확인 기준 (항목 수)"/>
                                            <DockPanel Grid.Column="2" Width="260" VerticalAlignment="Center">
                                                <TextBlock x:Name="BatchThresholdText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="BatchThresholdSlider" AutomationProperties.Name="확인 기준 (항목 수)" Minimum="5" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BatchThresholdSlider_ValueChanged"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 바탕화면 페이지 ============================== -->
            <TabItem x:Name="AnimationTab" Header="바탕화면 페이지">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,26,38" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="바탕화면 페이지" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="여러 바탕화면 페이지를 넘기는 마우스·터치 동작과 넘길 때의 전환 효과를 정합니다." Style="{StaticResource PageDescription}"/>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DeckModuleCheck}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border CornerRadius="6" Background="#2A2416" BorderBrush="#5C4A22" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>

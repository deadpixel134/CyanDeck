                                <TextBlock x:Name="UpdatesSection" Text="자동 업데이트" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <StackPanel>
                                        <CheckBox x:Name="AutomaticUpdateCheck" Content="업데이트 자동 확인"/>

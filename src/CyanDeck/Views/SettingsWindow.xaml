                        <CheckBox x:Name="AutomaticSnapshotScreenPreviewCheck" Content="자동 일일 백업에도 바탕화면 이미지 저장"/>
                        <TextBlock Foreground="#98A3B3" Text="화면 미리보기에는 다른 앱의 내용이 포함될 수 있어 개인정보 보호에 민감합니다. 기본값은 꺼짐입니다." TextWrapping="Wrap" Margin="0,-3,0,7"/>
                        <TextBlock Text="자동 백업 보관 기간"/>
                        <DockPanel><TextBlock x:Name="AutoSnapshotDaysText" DockPanel.Dock="Right"/><Slider x:Name="AutoSnapshotDaysSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AutoSnapshotDaysSlider_ValueChanged"/></DockPanel>
                        <TextBlock Text="수동 스냅샷 최대 개수"/>
                        <DockPanel><TextBlock x:Name="SnapshotCountText" DockPanel.Dock="Right"/><Slider x:Name="SnapshotCountSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SnapshotCountSlider_ValueChanged"/></DockPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="저장된 모니터 레이아웃 초기화…" Margin="0,0,8,8" Click="ResetMonitorLayouts_Click"
                                    Style="{StaticResource DeckDangerButtonStyle}"/>
                            <Button x:Name="AutomaticLayoutButton" Content="자동 레이아웃 실행…" Margin="0,0,8,8" Click="AutomaticLayout_Click"/>
                            <Button x:Name="SwapScreenContentsButton" Content="화면 내용 교환…" Margin="0,0,0,8" Click="SwapScreenContents_Click"/>
                        </WrapPanel>
                        <TextBlock Foreground="#98A3B3" Text="연결된 두 모니터를 선택해 그룹과 그룹 밖 아이콘의 화면 위치를 서로 교환합니다. 파일 자체는 이동하지 않으며 실행 전 복구 체크포인트를 만듭니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="BackupSection" Text="백업 내보내기·가져오기" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="그룹 배치와 CyanDeck 설정을 파일로 내보내거나, 내보낸 파일에서 되돌립니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="레이아웃 및 설정 내보내기…" Margin="0,0,8,0" Click="Export_Click"/>
                            <Button x:Name="ImportConfigurationButton" Content="백업 가져오기…" Margin="0" Click="Import_Click"/>
                        </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CalendarTab" Header="캘린더">

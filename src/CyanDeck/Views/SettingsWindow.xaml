                        </DockPanel>
                        <TextBlock Text="사용 중(마우스를 올렸을 때·편집 중) 배경 불투명도" Margin="0,6,0,3"/>
                        <DockPanel Width="280" HorizontalAlignment="Left">
                            <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Text="{Binding Value, ElementName=CalendarActiveOpacitySlider, StringFormat='{}{0:P0}'}"/>
                            <Slider x:Name="CalendarActiveOpacitySlider" Minimum="0.15" Maximum="1" Value="0.86"/>
                        </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#222831" BorderBrush="#394352" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                        <TextBlock x:Name="GoogleSection" Text="Google 연결" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="일반 배포본에는 Google 데스크톱 OAuth 클라이언트 정보가 내장되어 있어 보통은 비워 두면 됩니다. 로그인은 캘린더 화면의 '설정 → Google 계정 연결 / 캘린더 불러오기'에서 기본 브라우저로 진행하고, 일정 업로드·다운로드는 캘린더의 '동기화' 버튼으로 실행합니다. OAuth 클라이언트 ID가 없으면 로컬 일정만 사용합니다." Foreground="#98A3B3" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="OAuth 데스크톱 클라이언트 ID (직접 지정할 때만)" Margin="0,0,0,4"/>
                        <TextBox x:Name="GoogleClientIdBox" Height="30" Padding="7,3" ToolTip="Google Cloud Console에서 데스크톱 OAuth 클라이언트 ID를 입력하세요."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SystemIconsTab" Header="바탕화면 아이콘·휴지통">

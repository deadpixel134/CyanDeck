<Window x:Class="CyanDeck.Views.MonitorContentSwapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="화면 내용 교환" Width="520" Height="390"
        MinWidth="500" MinHeight="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#15171B" Foreground="#F2F4F8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0F8"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                <Setter Property="Margin" Value="0,5,0,12"/>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}">
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="Padding" Value="18,7"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="연결된 두 화면의 CyanDeck 내용을 서로 교환합니다."
                       FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="그룹과 CyanDeck이 관리하는 그룹 밖 아이콘의 모니터 소유권과 위치만 바뀝니다. 파일 자체는 이동하지 않으며 실행 전에 복구 체크포인트를 만듭니다."
                       Foreground="#98A3B3" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="첫 번째 화면"/>
            <ComboBox x:Name="FirstMonitorCombo" DisplayMemberPath="Label" SelectionChanged="MonitorSelection_Changed"/>
            <TextBlock Text="두 번째 화면"/>
            <ComboBox x:Name="SecondMonitorCombo" DisplayMemberPath="Label" SelectionChanged="MonitorSelection_Changed"/>

            <CheckBox x:Name="IncludeLockedGroupsCheck" Content="잠긴 그룹도 함께 교환" IsChecked="True"/>
            <CheckBox x:Name="ScaleSizeCheck" Content="대상 화면의 작업 영역 크기에 맞춰 그룹 크기도 조정" IsChecked="True"/>
            <TextBlock x:Name="ValidationText" Foreground="#FFB0B0" Margin="0,9,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="취소" Click="Cancel_Click"/>
            <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="교환" Click="Swap_Click"/>
        </DockPanel>
    </Grid>
</Window>

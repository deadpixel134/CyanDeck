<Window x:Class="CyanDeck.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:CyanDeck.Layout"
        Title="CyanDeck"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="False"
        MinWidth="220"
        MinHeight="42"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        AutomationProperties.Name="CyanDeck group">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#F4F6FA"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <ItemsPanelTemplate x:Key="GridItemsPanel">
            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListItemsPanel">
            <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalListItemsPanel">
            <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="GridItemTemplate">
            <Grid Width="{Binding TileWidth}" Height="{Binding TileHeight}" Margin="1" Opacity="{Binding CutOpacity}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Source="{Binding Icon}" Width="{Binding IconDisplaySize}" Height="{Binding IconDisplaySize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Loaded="ItemIcon_Loaded" Unloaded="ItemIcon_Unloaded"/>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#F4F6FA" FontSize="{DynamicResource DeckGridLabelFontSize}"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="{DynamicResource DeckGridLabelMaxHeight}" Margin="2,2,2,0" ToolTip="{Binding Path}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLabelAlways}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowLabelOnHover}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ListItemTemplate">
            <Grid Margin="4,3" MinHeight="44" MinWidth="260" Opacity="{Binding CutOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="2,0,10,0" Stretch="Uniform" VerticalAlignment="Center" Loaded="ItemIcon_Loaded" Unloaded="ItemIcon_Unloaded"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="#F4F6FA" FontSize="{DynamicResource DeckListLabelFontSize}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="#8490A0" FontSize="{DynamicResource DeckSecondaryLabelFontSize}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#9CA8B8" FontSize="{DynamicResource DeckSecondaryLabelFontSize}" Margin="12,0,5,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DetailsItemTemplate">
            <layout:DetailsColumnsPanel Margin="2,1" MinHeight="30" MinWidth="460" Opacity="{Binding CutOpacity}">
                <Image layout:DetailsColumnsPanel.ColumnKind="Icon" Source="{Binding Icon}" Width="22" Height="22" Margin="4,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Loaded="ItemIcon_Loaded" Unloaded="ItemIcon_Unloaded"/>
                <TextBlock layout:DetailsColumnsPanel.ColumnKind="Name" Text="{Binding Name}" Foreground="#F4F6FA" FontSize="{DynamicResource DeckGridLabelFontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Padding="2,0"/>
                <TextBlock layout:DetailsColumnsPanel.ColumnKind="Modified" Text="{Binding ModifiedText}" Foreground="#AAB4C2" FontSize="{DynamicResource DeckSecondaryLabelFontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="2,0"/>
                <TextBlock layout:DetailsColumnsPanel.ColumnKind="Type" Text="{Binding Type}" Foreground="#AAB4C2" FontSize="{DynamicResource DeckSecondaryLabelFontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="2,0"/>
                <TextBlock layout:DetailsColumnsPanel.ColumnKind="Size" Text="{Binding SizeText}" Foreground="#AAB4C2" FontSize="{DynamicResource DeckSecondaryLabelFontSize}"
                           VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,6,0" Padding="2,0"/>
            </layout:DetailsColumnsPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Shell"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="18" ShadowDepth="3" Opacity="0.34"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="BodyRow" Height="*"/>
                <RowDefinition x:Name="BottomHeaderRow" Height="0"/>
            </Grid.RowDefinitions>

            <Canvas x:Name="WallpaperBlurBackdrop" Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="-1"/>

            <Border x:Name="HeaderPanel" Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    AllowDrop="True" Drop="Header_Drop" DragOver="Window_DragOver"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid x:Name="HeaderContent" Margin="7,4,5,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <StackPanel x:Name="HeaderButtonsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SearchButton" Width="28" Height="28" Margin="2,0" Content="⌕"
                                ToolTip="검색 (Ctrl+F)" Click="SearchButton_Click"
                                Background="Transparent" Foreground="#EAF0F8" BorderThickness="0" FontSize="15"/>
                        <Button x:Name="RollButton" Width="28" Height="28" Margin="2,0" Content="⌃"
                                ToolTip="그룹 접기/펼치기" AutomationProperties.Name="그룹 접기 또는 펼치기" Click="RollButton_Click"
                                Background="Transparent" Foreground="#EAF0F8" BorderThickness="0" FontSize="15"/>
                        <Button Width="28" Height="28" Margin="2,0" Content="•••"
                                ToolTip="메뉴" AutomationProperties.Name="그룹 메뉴" Click="MenuButton_Click"
                                Background="Transparent" Foreground="#EAF0F8" BorderThickness="0" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed" Padding="8,5"
                    Background="#D9191C21" BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="28" Padding="8,3" VerticalContentAlignment="Center"
                             Background="#24FFFFFF" Foreground="#F4F6FA" BorderBrush="#38FFFFFF"
                             TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Filter items"/>
                    <TextBlock x:Name="SearchCountText" Grid.Column="1" Margin="8,0" Foreground="#9EABB9" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Width="28" Height="28" Content="×" Padding="0" ToolTip="검색 지우기 및 닫기" Click="SearchClose_Click"/>
                </Grid>
            </Border>


            <Border x:Name="PortalNavPanel" Grid.Row="2" Visibility="Collapsed" Padding="7,4"
                    Background="#C9181B20" BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PortalBackButton" Width="27" Height="25" Margin="0,0,3,0" Content="←" ToolTip="뒤로 (Alt+왼쪽)" Click="PortalBack_Click"/>
                    <Button x:Name="PortalForwardButton" Grid.Column="1" Width="27" Height="25" Margin="0,0,3,0" Content="→" ToolTip="앞으로 (Alt+오른쪽)" Click="PortalForward_Click"/>
                    <Button x:Name="PortalUpButton" Grid.Column="2" Width="27" Height="25" Margin="0,0,6,0" Content="↑"
                            ToolTip="상위 폴더 (Alt+위쪽). Shift+클릭 또는 오른쪽 클릭으로 포털 루트로 이동."
                            Click="PortalUp_Click" PreviewMouseRightButtonUp="PortalUp_PreviewMouseRightButtonUp"/>
                    <TextBlock x:Name="PortalPathText" Grid.Column="3" VerticalAlignment="Center" Foreground="#A9B4C2" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="PortalHomeButton" Grid.Column="4" Width="48" Height="25" Margin="6,0,0,0" Content="홈" ToolTip="포털 루트로 돌아가기" Click="PortalHome_Click"/>
                </Grid>
            </Border>

            <Border x:Name="BodyPanel" Grid.Row="3" Padding="6,8,6,6"
                    PreviewMouseLeftButtonDown="BodyPanel_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="DetailsHeaderPanel" Grid.Row="0" Visibility="Collapsed"
                            Background="#24111418" BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1"
                            Margin="0,0,0,3" Padding="2,1">
                        <layout:DetailsColumnsPanel MinWidth="460">
                            <Button x:Name="DetailsNameButton" layout:DetailsColumnsPanel.ColumnKind="Name" Content="이름" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="2,3" Click="DetailsName_Click"/>
                            <Button x:Name="DetailsModifiedButton" layout:DetailsColumnsPanel.ColumnKind="Modified" Content="수정한 날짜" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="2,3" Click="DetailsModified_Click"/>
                            <Button x:Name="DetailsTypeButton" layout:DetailsColumnsPanel.ColumnKind="Type" Content="형식" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="2,3" Click="DetailsType_Click"/>
                            <Button x:Name="DetailsSizeButton" layout:DetailsColumnsPanel.ColumnKind="Size" Content="크기" HorizontalContentAlignment="Right"
                                    Background="Transparent" BorderThickness="0" Padding="2,3" Click="DetailsSize_Click"/>
                        </layout:DetailsColumnsPanel>
                    </Border>

                    <ListBox x:Name="ItemsList" Grid.Row="1"
                             AutomationProperties.Name="CyanDeck items"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F3F6FA"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="ItemsList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                             PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                             PreviewMouseMove="ItemsList_PreviewMouseMove">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="Loaded" Handler="ItemContainer_Loaded"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3B78A8FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <ScrollViewer x:Name="FreeScroll" Grid.Row="1" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Canvas x:Name="FreeCanvas" MinWidth="200" MinHeight="120" Background="Transparent" PreviewMouseLeftButtonDown="FreeCanvas_PreviewMouseLeftButtonDown"/>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyText" Grid.Row="1" Text="파일을 여기에 놓으세요" Foreground="#80FFFFFF" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <!-- Same round translucent resize handle used by the Calendar. -->
            <Thumb x:Name="ResizeGrip" Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="20" Height="20" Cursor="SizeNWSE" Background="Transparent"
                   Template="{StaticResource DesktopResizeGripTemplate}"
                   ToolTip="드래그하여 그룹 크기 변경" AutomationProperties.Name="그룹 크기 조절"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
        </Grid>
    </Border>
</Window>

<Window x:Class="CyanDeck.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동 분류 규칙" Width="760" Height="560"
        MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#17191E" Foreground="#F4F6FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkControls.xaml"/>
                <ResourceDictionary Source="../Themes/ReadableComboBoxes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>
        <!-- Dark column headers instead of the light stock DataGrid header. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20242B"/>
            <Setter Property="Foreground" Value="#C9D3DF"/>
            <Setter Property="BorderBrush" Value="#3A424E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="탭" Margin="0,0,8,0"/>
            <ComboBox x:Name="TabPicker" Grid.Column="1" SelectionChanged="TabPicker_SelectionChanged"/>
            <TextBlock Grid.Column="3" Text="일치 방식" Margin="0,0,8,0"/>
            <ComboBox x:Name="MatchModeCombo" Grid.Column="4"/>
            <TextBlock Grid.Column="6" Text="우선순위" Margin="0,0,8,0"/>
            <TextBox x:Name="PriorityBox" Grid.Column="7" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,14,0,10" Foreground="#AAB4C3" TextWrapping="Wrap"
                   Text="규칙은 탭 우선순위가 높은 순서로 평가됩니다. '하나라도 일치'는 활성 규칙 중 하나 이상이 맞으면 이 탭으로 보내고, '모두 일치'는 모든 활성 규칙이 맞아야 합니다."/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                      Background="#111318" Foreground="#F4F6FA" RowBackground="#15181D" AlternatingRowBackground="#1B1E24"
                      BorderBrush="#35FFFFFF" SelectionUnit="FullRow" HorizontalGridLinesBrush="#2A3038">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled, Mode=TwoWay}" Width="48"/>
                    <DataGridComboBoxColumn x:Name="FieldColumn" Header="조건" Width="220"/>
                    <DataGridTextColumn Header="값" Binding="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="추가" Click="Add_Click"/>
                    <Button Content="삭제" Click="Remove_Click"/>
                    <Button Content="위로" Click="Up_Click"/>
                    <Button Content="아래로" Click="Down_Click"/>
                    <Button Content="일치 항목 미리보기" Click="Preview_Click" MinWidth="112"/>
                </StackPanel>
                <TextBlock x:Name="PreviewText" Margin="16,0,0,0" Foreground="#8F9AAA" TextWrapping="Wrap"
                           Text="값 안내: 크기 규칙은 MB, 요일은 월·화·수 또는 월요일처럼 쓰고 여러 개는 쉼표로 구분(Monday, Mon, 1…7도 가능), 시간 범위는 HH:mm-HH:mm 형식입니다. 파일 분류는 앱/설치/PDF/시트/발표/문서/텍스트/코드/이미지/동영상/오디오/압축/폴더/기타를 지원합니다. 미리보기는 규칙을 실제 적용하지 않고 현재 Windows 바탕화면을 검사합니다."/>
            </DockPanel>
        </Grid>

        <!-- Same save model as the Settings window: one save point, closing asks about unsaved rules. -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="12,8" CornerRadius="8" BorderThickness="1"
                Background="#1A1E24" BorderBrush="#2C333D">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="저장" Click="Apply_Click" Style="{StaticResource DeckPrimaryButtonStyle}"
                            Padding="22,6" Margin="10,0,0,0" ToolTip="바꾼 규칙을 저장하고 바로 적용합니다 (Ctrl+S)"/>
                    <Button Content="닫기" IsCancel="True" Click="Cancel_Click" ToolTip="창을 닫습니다. 저장하지 않은 규칙이 있으면 먼저 묻습니다."/>
                </StackPanel>
                <TextBlock x:Name="SaveStateText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#8F9AA8"
                           Text="바꾼 규칙은 '저장'을 눌러야 적용됩니다."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

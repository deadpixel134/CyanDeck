<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>CyanDeck</Product>
    <Title>CyanDeck</Title>
    <AssemblyName>CyanDeck</AssemblyName>
    <RootNamespace>CyanDeck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <LangVersion>12.0</LangVersion>
    <Version>8.0.19</Version>
  </PropertyGroup>
  <!-- An EXE-only distribution embeds the independent update/rollback installer. -->
  <ItemGroup>
    <EmbeddedResource Include="../../apply-update.ps1" LogicalName="CyanDeck.BundledUpdaterScript" />
  </ItemGroup>
  <!-- Production builds pin the PUBLIC update verification SPKI in CyanDeck.exe. -->
  <ItemGroup Condition="'$(CyanDeckReleasePublicKeyPath)' != '' and Exists('$(CyanDeckReleasePublicKeyPath)')">
    <EmbeddedResource Include="$(CyanDeckReleasePublicKeyPath)"
                      LogicalName="CyanDeck.TrustedUpdatePublicKey" />
  </ItemGroup>
  <!-- Native Desktop OAuth is public-client application metadata; never a user token.
       The distributor provisions this once. Release users need no JSON next to EXE. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../json/client_secret.json')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/../../json/client_secret.json"
                      LogicalName="CyanDeck.OAuthDesktopClient" />
  </ItemGroup>
</Project>
